import { track, effect } from 'ripple';
import { git } from '../../lib/tauri';
import { workspacePath, subscribeToWorkspacePath, openFile } from '../../lib/workspace';

interface GitFileEntry {
  path: string;
  fileName: string;
  status: string;
  statusLabel: string;
  statusColor: string;
}

function parseStatus(code: string): { label: string; color: string } {
  switch (code) {
    case 'M':
      return { label: 'Modified', color: 'text-warning' };
    case 'A':
      return { label: 'Added', color: 'text-success' };
    case 'D':
      return { label: 'Deleted', color: 'text-error' };
    case 'R':
      return { label: 'Renamed', color: 'text-info' };
    case 'C':
      return { label: 'Copied', color: 'text-info' };
    case '?':
    case '??':
      return { label: 'Untracked', color: 'text-success' };
    case 'U':
      return { label: 'Unmerged', color: 'text-warning' };
    default:
      return { label: code, color: 'text-text-muted' };
  }
}

function statusShort(code: string): string {
  switch (code) {
    case 'M':
      return 'M';
    case 'A':
      return 'A';
    case 'D':
      return 'D';
    case 'R':
      return 'R';
    case 'C':
      return 'C';
    case '?':
    case '??':
      return 'U';
    default:
      return code.charAt(0);
  }
}

export component SourceControl() {
  let branch = track<string | null>(null);
  let changes = track<GitFileEntry[]>([]);
  let isLoading = track(true);
  let hasRepo = track(false);
  let refreshCounter = track(0);

  const refresh = async () => {
    const wsPath = workspacePath;
    if (!wsPath) {
      @hasRepo = false;
      @isLoading = false;
      @changes = [];
      @branch = null;
      return;
    }

    @isLoading = true;

    try {
      const [branchName, statuses] = await Promise.all([
        git.getBranch(wsPath),
        git.getStatus(wsPath),
      ]);

      @branch = branchName;
      @hasRepo = branchName !== null;

      const newChanges: GitFileEntry[] = [];
      for (const [filePath, statusCode] of Object.entries(statuses)) {
        const parts = filePath.split('/');
        const fileName = parts[parts.length - 1] || filePath;
        const { label, color } = parseStatus(statusCode);
        newChanges.push(
          {
            path: filePath,
            fileName,
            status: statusCode,
            statusLabel: label,
            statusColor: color,
          },
        );
      }

      // Sort: Modified first, then Added, then Untracked, then rest
      const order: Record<string, number> = { M: 0, A: 1, D: 2, R: 3, '?': 4, '??': 4 };
      newChanges.sort((a, b) => {
        const ao = order[a.status] ?? 5;
        const bo = order[b.status] ?? 5;
        if (ao !== bo) return ao - bo;
        return a.path.localeCompare(b.path);
      });

      @changes = newChanges;
    } catch (error) {
      console.error('Failed to fetch git status:', error);
      @hasRepo = false;
      @changes = [];
      @branch = null;
    } finally {
      @isLoading = false;
    }
  };

  // Subscribe to workspace path changes
  effect(() => {
    const unsubscribe = subscribeToWorkspacePath(() => {
      refresh();
    });

    refresh();

    return unsubscribe;
  });

  // Auto-refresh every 5 seconds when visible
  effect(() => {
    const interval = setInterval(() => {
      @refreshCounter = @refreshCounter + 1;
      refresh();
    }, 5000);

    return () => clearInterval(interval);
  });

  const handleFileClick = (entry: GitFileEntry) => {
    const wsPath = workspacePath;
    if (!wsPath) return;
    const fullPath = wsPath + '/' + entry.path;
    openFile(fullPath, entry.fileName);
  };

  <div class="flex flex-col h-full">
    <header class="flex items-center justify-between px-4 pt-3 pb-2">
      <span class="text-[11px] font-semibold text-text-secondary tracking-wider">
        {'SOURCE CONTROL'}
      </span>
      <button
        class="flex items-center justify-center w-5 h-5 rounded bg-transparent border-none text-text-muted cursor-pointer hover:text-text-primary hover:bg-bg-hover transition-colors"
        onClick={() => refresh()}
        title="Refresh"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
          <path
            d="M13.987 6.046a.75.75 0 0 1 .467.954 7.001 7.001 0 0 1-12.906 1.572L.834 10H3.5a.75.75 0 0 1 0 1.5H.75a.75.75 0 0 1-.75-.75V8a.75.75 0 0 1 1.5 0v1.585l.634-.972A5.501 5.501 0 0 0 12.5 6.5a5.474 5.474 0 0 0-.533-2.353.75.75 0 0 1 1.02-1.003l.003.001.002.001.005.003a.75.75 0 0 1-.009-.103zM2.513 9.954a.75.75 0 0 1-.467-.954 7.001 7.001 0 0 1 12.906-1.572L15.666 6H13a.75.75 0 0 1 0-1.5h2.75a.75.75 0 0 1 .75.75v2.75a.75.75 0 0 1-1.5 0V6.415l-.634.972A5.501 5.501 0 0 0 4 9.5c0 .832.185 1.621.515 2.329a.75.75 0 0 1-1.002 1.022l-.003-.001-.002-.001-.005-.003a.75.75 0 0 1 .01.108z"
          />
        </svg>
      </button>
    </header>

    if (@isLoading && @changes.length === 0) {
      <div class="flex-1 flex items-center justify-center text-text-muted text-xs">
        <span>{'Loading...'}</span>
      </div>
    } else if (!@hasRepo) {
      <div
        class="flex-1 flex flex-col items-center justify-center px-4 py-6 text-center text-text-muted text-xs"
      >
        <svg class="w-12 h-12 mb-3 opacity-30" viewBox="0 0 16 16" fill="currentColor">
          <path
            d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25zM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0z"
          />
        </svg>
        <p>{'No repository detected'}</p>
      </div>
    } else {
      <div class="px-3 pb-2">
        <div
          class="flex items-center gap-1.5 px-2 py-1.5 bg-bg-elevated rounded text-xs text-text-secondary"
        >
          <svg class="w-3.5 h-3.5 text-accent shrink-0" viewBox="0 0 16 16" fill="currentColor">
            <path
              d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25zM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0z"
            />
          </svg>
          <span>{@branch || 'HEAD'}</span>
        </div>
      </div>

      if (@changes.length === 0) {
        <div
          class="flex-1 flex flex-col items-center justify-center px-4 py-6 text-center text-text-muted text-xs"
        >
          <svg class="w-8 h-8 mb-2 opacity-20" viewBox="0 0 16 16" fill="currentColor">
            <path
              d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"
            />
          </svg>
          <p>{'No changes detected'}</p>
        </div>
      }

      if (@changes.length > 0) {
        <div class="px-3 pb-1.5">
          <span class="text-[11px] text-text-muted">
            {String(@changes.length)}
            {@changes.length === 1 ? ' change' : ' changes'}
          </span>
        </div>

        <div class="flex-1 overflow-auto">
          for (const entry of @changes; index i) {
            <button
              class={{
                'flex items-center gap-2 w-full px-3 py-1 text-left hover:bg-bg-hover transition-colors duration-100 cursor-pointer bg-transparent border-none': true,
                'opacity-60': entry.status === 'D',
              }}
              onClick={() => handleFileClick(entry)}
              title={entry.path + ' - ' + entry.statusLabel}
            >
              <svg
                class="w-3.5 h-3.5 text-text-muted shrink-0"
                viewBox="0 0 16 16"
                fill="currentColor"
              >
                <path
                  d="M3.75 1.5a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25V4.664a.25.25 0 0 0-.073-.177l-2.914-2.914a.25.25 0 0 0-.177-.073H3.75zM2 1.75C2 .784 2.784 0 3.75 0h5.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 12.25 16h-8.5A1.75 1.75 0 0 1 2 14.25V1.75z"
                />
              </svg>
              <span class="text-xs text-text-primary truncate flex-1">{entry.fileName}</span>
              <span
                class="text-[10px] text-text-muted truncate max-w-[40%] hidden group-hover:inline"
              >
                {entry.path}
              </span>
              <span
                class={{
                  'text-[11px] font-mono font-semibold shrink-0 w-4 text-center': true,
                  [entry.statusColor]: true,
                }}
              >
                {statusShort(entry.status)}
              </span>
            </button>
          }
        </div>
      }
    }
  </div>
}

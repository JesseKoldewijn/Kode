import { track, effect, type Tracked, trackSplit } from 'ripple';
import { fs, type SearchResult } from '../../lib/tauri';
import { workspacePath, openFile } from '../../lib/workspace';
import { actions, getDisplayString, type Action } from '../../lib/keybindings';

export type PaletteMode = 'files' | 'commands';

export component CommandPalette(props: {
  isOpen: Tracked<boolean>;
  mode?: PaletteMode;
  onClose: () => void;
  onAction?: (actionId: string) => void;
}) {
  // Use trackSplit to make isOpen reactive when passed as Tracked<boolean>
  const [isOpen, rest] = trackSplit(props, ['isOpen']);
  const { onClose, onAction, mode } = @rest;

  const handleAction = (actionId: string) => {
    if (onAction) onAction(actionId);
  };

  let query = track('');
  let fileResults = track<SearchResult[]>([]);
  let selectedIndex = track(0);
  let isSearching = track(false);
  let inputRef = track<HTMLInputElement | null>(null);
  let searchTimeout = track<number | null>(null);
  let currentMode = track<PaletteMode>(mode || 'files');
  let filteredCommands = track<Action[]>([]);
  let resultCount = track(0);

  const isMac = typeof navigator !== 'undefined' && navigator.platform.includes('Mac');

  // Reset state when palette opens
  // Read mode from @rest inside effect to ensure we get the current prop value reactively
  effect(() => {
    if (@isOpen) {
      const currentPropMode = (@rest).mode || 'files';
      @currentMode = currentPropMode;
      @query = currentPropMode === 'commands' ? '>' : '';
      @fileResults = [];
      @selectedIndex = 0;
      @resultCount = 0;
      if (currentPropMode === 'commands') {
        updateCommandFilter('');
      }
    }
  });

  // Auto-focus input when palette opens
  effect(() => {
    if (@isOpen) {
      // Use multiple strategies to ensure focus works
      const focusInput = () => {
        const input = document.getElementById('command-palette-input') as HTMLInputElement | null;
        if (input) {
          input.focus();
          console.log('CommandPalette: Input focused');
        } else {
          console.warn('CommandPalette: Input not found');
        }
      };

      // Try immediately
      focusInput();

      // Also try after next frame to ensure DOM is ready
      requestAnimationFrame(() => {
        focusInput();
      });
    }
  });

  // Document-level ESC key handler
  effect(() => {
    if (!@isOpen) return;

    const handleDocumentKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        e.stopPropagation();
        onClose();
      }
    };

    document.addEventListener('keydown', handleDocumentKeyDown, true); // Use capture phase

    return () => {
      document.removeEventListener('keydown', handleDocumentKeyDown, true);
    };
  });

  // Filter logic: react to query changes
  effect(() => {
    const q = @query;

    // Determine mode from prefix
    if (q.startsWith('>')) {
      @currentMode = 'commands';
      updateCommandFilter(q.slice(1).trim());
      return;
    }

    @currentMode = 'files';

    // File search
    const root = workspacePath;

    if (@searchTimeout) {
      clearTimeout(@searchTimeout);
    }

    if (!q.trim() || !root) {
      @fileResults = [];
      @selectedIndex = 0;
      @resultCount = 0;
      return;
    }

    @isSearching = true;

    @searchTimeout = setTimeout(async () => {
      try {
        const searchResults = await fs.searchFiles(root, q, 20);
        @fileResults = searchResults;
        @selectedIndex = 0;
        @resultCount = searchResults.length;
      } catch (error) {
        console.error('Search failed:', error);
      } finally {
        @isSearching = false;
      }
    }, 150) as unknown as number;
  });

  const updateCommandFilter = (filter: string) => {
    const lowerFilter = filter.toLowerCase();
    const filtered =
      lowerFilter
        ? actions.filter(
            (a) => a.label.toLowerCase().includes(lowerFilter) ||
              a.category.toLowerCase().includes(lowerFilter) ||
              a.description && a.description.toLowerCase().includes(lowerFilter),
          )
        : [...actions];
    @filteredCommands = filtered;
    @resultCount = filtered.length;
    @selectedIndex = 0;
  };

  const getKeybindingDisplay = (action: Action): string => {
    const binding = action.defaultBinding;
    const keyStr =
      isMac && binding.mac ? binding.mac : binding.key;
    if (!keyStr) return '';
    return getDisplayString(keyStr);
  };

  const handleKeyDown = (e: KeyboardEvent) => {
    // ESC is now handled at document level
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      @selectedIndex = Math.min(@selectedIndex + 1, @resultCount - 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      @selectedIndex = Math.max(@selectedIndex - 1, 0);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (@currentMode === 'commands') {
        const cmds = @filteredCommands;
        if (cmds.length > 0 && @selectedIndex < cmds.length) {
          selectCommand(cmds[@selectedIndex]);
        }
      } else {
        if (@fileResults.length > 0) {
          selectResult(@fileResults[@selectedIndex]);
        }
      }
    }
  };

  const selectResult = (result: SearchResult) => {
    openFile(result.path, result.name);
    onClose();
  };

  const selectCommand = (action: Action) => {
    onClose();
    handleAction(action.id);
  };

  const getRelativePath = (fullPath: string) => {
    const root = workspacePath;
    if (root && fullPath.startsWith(root)) {
      return fullPath.slice(root.length + 1);
    }
    return fullPath;
  };

  const getFileIcon = (name: string): string => {
    const ext = name.split('.').pop()?.toLowerCase();
    switch (ext) {
      case 'ts':
      case 'tsx':
        return '#3178c6';
      case 'js':
      case 'jsx':
        return '#f7df1e';
      case 'json':
        return '#cbcb41';
      case 'md':
        return '#519aba';
      case 'css':
        return '#563d7c';
      case 'html':
        return '#e34c26';
      case 'rs':
        return '#dea584';
      case 'py':
        return '#3572a5';
      case 'ripple':
        return '#61dafb';
      default:
        return '#6e6e6e';
    }
  };

  <div
    class={{ 'fixed inset-0 z-[500] flex justify-center pt-[15vh]': true, hidden: !@isOpen }}
    onClick={(e: MouseEvent) => {
      if (e.target === e.currentTarget) onClose();
    }}
  >
    <div class="absolute inset-0 bg-black/50" />

    <div
      class="relative w-full max-w-[520px] max-h-[70vh] mx-4 bg-bg-surface border border-border-default rounded-xl shadow-lg overflow-hidden flex flex-col animate-slideIn"
    >
      <header class="flex items-center gap-3 px-4 py-3 border-b border-border-default">
        <svg
          class="w-[18px] h-[18px] text-text-muted shrink-0"
          viewBox="0 0 16 16"
          fill="currentColor"
        >
          <path
            d={@currentMode === 'commands'
              ? 'M3.5 2h-1v5h1V2zm6.1 5H6.4L6 6.45v-1L6.4 5h3.2l.4.5v1l-.4.5zm-5 3H1.4L1 9.5v-1l.4-.5h3.2l.4.5v1l-.4.5zm3.9-8h-1v2.5h1V2zm-1 6h1v6h-1V8zm-4 3h-1v3h1v-3zm7.9 0h3.19l.4-.5v-.95l-.4-.5H11.4l-.4.5v.95l.4.5zm2.1-9h-1v6h1V2zm-1 10h1v2h-1v-2z'
              : 'M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z'}
          />
        </svg>
        <input
          id="command-palette-input"
          type="text"
          autofocus
          class="flex-1 bg-transparent border-none outline-none text-sm text-text-primary placeholder:text-text-muted"
          placeholder={@currentMode === 'commands' ? 'Type a command...' : 'Search files...'}
          value={@query}
          onInput={(e: InputEvent) => (@query = (e.target as HTMLInputElement).value)}
          onKeyDown={handleKeyDown}
          ref={(el: HTMLInputElement) => {
            @inputRef = el;
            return () => {
              @inputRef = null;
            };
          }}
        />
        <svg
          class={{ 'w-4 h-4 text-text-muted animate-spin': true, hidden: !@isSearching }}
          viewBox="0 0 16 16"
          fill="none"
        >
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" opacity="0.25" />
          <path
            d="M14 8a6 6 0 0 0-6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
        <kbd
          class="px-2 py-0.5 text-[11px] bg-bg-elevated border border-border-default rounded text-text-muted cursor-pointer hover:bg-bg-hover transition-colors"
          onClick={(e: MouseEvent) => {
            e.stopPropagation();
            onClose();
          }}
        >
          {'esc'}
        </kbd>
      </header>

      <div class="flex-1 overflow-y-auto max-h-[50vh]">
        <div class={{ hidden: @currentMode !== 'files' }}>
          <div
            class={{
              'py-8 px-4 text-center text-text-muted text-[13px]': true,
              hidden: @fileResults.length > 0 || !@query.trim(),
            }}
          >
            {@isSearching ? 'Searching...' : 'No files found'}
          </div>

          <div
            class={{
              'py-8 px-4 text-center text-text-muted text-[13px]': true,
              hidden: @fileResults.length > 0 || @query.trim(),
            }}
          >
            {'Type to search for files, or type > for commands'}
          </div>

          <div class={{ hidden: @fileResults.length === 0 }}>
            for (const result of @fileResults; index i) {
              const isSelected = i === @selectedIndex;

              <div
                class={{
                  'flex items-center gap-3 px-4 py-2.5 cursor-pointer transition-colors duration-100': true,
                  'bg-bg-hover': !isSelected,
                  'bg-accent-muted': isSelected,
                }}
                onClick={() => selectResult(result)}
                onMouseEnter={() => (@selectedIndex = i)}
              >
                <span
                  class="w-2 h-2 rounded-full shrink-0"
                  style={{ backgroundColor: getFileIcon(result.name) }}
                />
                <div class="flex-1 min-w-0 flex flex-col gap-0.5">
                  <span class="text-[13px] text-text-primary truncate">{result.name}</span>
                  <span class="text-[11px] text-text-muted truncate">
                    {getRelativePath(result.path)}
                  </span>
                </div>
              </div>
            }
          </div>
        </div>

        <div class={{ hidden: @currentMode !== 'commands' }}>
          <div
            class={{
              'py-8 px-4 text-center text-text-muted text-[13px]': true,
              hidden: @filteredCommands.length > 0,
            }}
          >
            {'No commands found'}
          </div>

          <div class={{ hidden: @filteredCommands.length === 0 }}>
            for (const cmd of @filteredCommands; index i) {
              const isSelected = i === @selectedIndex;
              const keybinding = getKeybindingDisplay(cmd);

              <div
                class={{
                  'flex items-center gap-3 px-4 py-2 cursor-pointer transition-colors duration-100': true,
                  'bg-bg-hover': !isSelected,
                  'bg-accent-muted': isSelected,
                }}
                onClick={() => selectCommand(cmd)}
                onMouseEnter={() => (@selectedIndex = i)}
              >
                <span class="text-[11px] text-text-muted font-medium w-16 shrink-0 truncate">
                  {cmd.category}
                </span>
                <span class="flex-1 text-[13px] text-text-primary truncate">{cmd.label}</span>
                <span
                  class={{
                    'text-[11px] text-text-muted px-1.5 py-0.5 bg-bg-elevated border border-border-default rounded font-mono': true,
                    hidden: !keybinding,
                  }}
                >
                  {keybinding}
                </span>
              </div>
            }
          </div>
        </div>
      </div>

      <footer class="flex gap-4 px-4 py-2 border-t border-border-default bg-bg-surface">
        <span class="flex items-center gap-1.5 text-[11px] text-text-muted">
          <kbd class="px-1.5 py-px bg-bg-elevated border border-border-default rounded-sm">
            {'↑↓'}
          </kbd>
          <span>{'navigate'}</span>
        </span>
        <span class="flex items-center gap-1.5 text-[11px] text-text-muted">
          <kbd class="px-1.5 py-px bg-bg-elevated border border-border-default rounded-sm">
            {'↵'}
          </kbd>
          <span>{@currentMode === 'commands' ? 'run' : 'open'}</span>
        </span>
        <span class="flex items-center gap-1.5 text-[11px] text-text-muted ml-auto">
          <span>{@currentMode === 'files' ? 'type > for commands' : 'remove > for files'}</span>
        </span>
      </footer>
    </div>
  </div>
}

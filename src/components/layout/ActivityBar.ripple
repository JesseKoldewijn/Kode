import { openSettings } from '../../lib/workspace';

export type ActivityTab = 'explorer' | 'search' | 'git';

export component ActivityBar(props: {
  activeTab: ActivityTab;
  onTabChange: (tab: ActivityTab) => void;
}) {
  const tabs: { id: ActivityTab; icon: string; title: string }[] = [
    {
      id: 'explorer',
      icon: 'M1.5 1A1.5 1.5 0 0 0 0 2.5v11A1.5 1.5 0 0 0 1.5 15h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 3H7.71L6.29 1.15A.5.5 0 0 0 5.9 1H1.5zm.5 2h3.879l1.5 1.5H14v9H2V3z',
      title: 'Explorer (Ctrl+Shift+E)',
    },
    {
      id: 'search',
      icon: 'M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z',
      title: 'Search (Ctrl+Shift+F)',
    },
    {
      id: 'git',
      icon: 'M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25zM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0z',
      title: 'Source Control (Ctrl+Shift+G)',
    },
  ];

  <div
    class="shrink-0 w-12 flex flex-col items-center py-2 bg-[var(--activity-bar-bg)] border-r border-border-default"
    data-testid="activity-bar"
  >
    for (const tab of tabs; key tab.id) {
      <button
        class={{
          'flex items-center justify-center w-10 h-10 rounded-md bg-transparent text-text-muted cursor-pointer transition-all duration-150 hover:text-text-primary hover:bg-bg-hover relative': true,
          'text-text-primary before:absolute before:left-0 before:top-1/2 before:-translate-y-1/2 before:w-0.5 before:h-6 before:bg-accent before:rounded-r-sm': props.activeTab ===
            tab.id,
        }}
        onClick={() => props.onTabChange(tab.id)}
        title={tab.title}
      >
        <svg class="w-5 h-5" viewBox="0 0 16 16" fill="currentColor">
          <path d={tab.icon} />
        </svg>
      </button>
    }
    <div class="flex-1" />
    <button
      class="flex items-center justify-center w-10 h-10 rounded-md bg-transparent text-text-muted cursor-pointer transition-all duration-150 hover:text-text-primary hover:bg-bg-hover"
      onClick={() => openSettings()}
      title="Settings (Ctrl+,)"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3" />
        <path
          d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
        />
      </svg>
    </button>
  </div>
}

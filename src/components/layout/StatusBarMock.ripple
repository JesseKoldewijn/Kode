import { track } from 'ripple';

// These are mock values for testing without Tauri
let workspacePath = track<string | null>(null);
let activeFileId = track<string | null>(null);
const openFiles: any[] = [];

export component StatusBarMock() {
  let branch = track('main');

  // Derive language from active file
  const activeLanguage = track(() => {
    const id = @activeFileId;
    if (!id) return 'Plain Text';
    const file = openFiles.find((f) => f.id === id);
    if (!file) return 'Plain Text';

    const langMap: Record<string, string> = {
      typescript: 'TypeScript',
      javascript: 'JavaScript',
      rust: 'Rust',
      python: 'Python',
      json: 'JSON',
      markdown: 'Markdown',
      css: 'CSS',
      html: 'HTML',
      toml: 'TOML',
      yaml: 'YAML',
      text: 'Plain Text',
    };
    return langMap[file.language] || file.language;
  });

  // Derive workspace name from path
  const workspaceName = track(() => {
    const path = @workspacePath;
    if (!path) return 'No Workspace';
    return path.split('/').pop() || path;
  });

  <div class="h-[22px] flex items-center justify-between bg-blue-600 text-white text-xs px-2">
    <div class="flex items-center gap-3">
      <button class="flex items-center gap-1 hover:bg-white/10 px-1.5 py-0.5 rounded">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M17.5 4.5c-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5-1.45 0-2.99.22-4.28.79C1.49 5.62 1 6.33 1 7.14v11.28c0 1.3 1.22 2.26 2.48 1.94.98-.25 2.02-.36 3.02-.36 1.56 0 3.22.26 4.56.92.6.3 1.28.3 1.88 0 1.34-.66 3-.92 4.56-.92 1 0 2.04.11 3.02.36 1.26.33 2.48-.63 2.48-1.94V7.14c0-.81-.49-1.52-1.22-1.85-1.29-.57-2.83-.79-4.28-.79z"
          />
        </svg>
        {@branch}
      </button>

      <button class="flex items-center gap-1 hover:bg-white/10 px-1.5 py-0.5 rounded">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"
          />
        </svg>
      </button>

      <button class="flex items-center gap-1.5 hover:bg-white/10 px-1.5 py-0.5 rounded">
        <span class="flex items-center gap-0.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
            />
          </svg>
          {'0'}
        </span>
        <span class="flex items-center gap-0.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
          </svg>
          {'0'}
        </span>
      </button>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-white/70 truncate max-w-[150px]" title={@workspacePath || ''}>
        {@workspaceName}
      </span>

      <span class="text-white/50 hidden lg:block">
        {'Ctrl+P: Search | Ctrl+B: Sidebar | Ctrl+`: Terminal'}
      </span>

      <button class="hover:bg-white/10 px-1.5 py-0.5 rounded">{@activeLanguage}</button>

      <button class="hover:bg-white/10 px-1.5 py-0.5 rounded">{'UTF-8'}</button>

      <button class="hover:bg-white/10 px-1.5 py-0.5 rounded">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
          />
        </svg>
      </button>
    </div>
  </div>
}

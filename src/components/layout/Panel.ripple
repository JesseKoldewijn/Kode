import { track, effect } from 'ripple';
import { Terminal, clearTerminal } from '../terminal/Terminal.ripple';
import { subscribeToAction, emitAction } from '../../lib/keybindings';
import {
  createSession,
  closeSession,
  setActiveSession,
  subscribeToSessions,
  type TerminalSession,
} from '../../lib/terminal-sessions';

export component Panel(props?: { onClose?: () => void }) {
  let activeTab = track<'terminal' | 'problems' | 'output'>('terminal');
  let terminalSessions = track<TerminalSession[]>([]);
  let activeTerminalId = track<string | null>(null);

  // Initialize session manager and subscribe to changes
  effect(() => {
    const unsub = subscribeToSessions((state) => {
      @terminalSessions = state.sessions;
      @activeTerminalId = state.activeSessionId;
    });

    // Create the first terminal session if none exist
    if (@terminalSessions.length === 0) {
      createSession();
    }

    return () => {
      unsub();
    };
  });

  // Subscribe to terminal actions
  effect(() => {
    const unsubscribeNew = subscribeToAction('terminal.new', () => {
      @activeTab = 'terminal';
      createSession();
    });

    const unsubscribeClear = subscribeToAction('terminal.clear', () => {
      @activeTab = 'terminal';
      const id = @activeTerminalId;
      if (id) {
        clearTerminal(id);
      }
    });

    return () => {
      unsubscribeNew();
      unsubscribeClear();
    };
  });

  const handleClose = () => {
    if (props?.onClose) {
      props.onClose();
    }
  };

  const handleNewTerminal = () => {
    @activeTab = 'terminal';
    createSession();
  };

  const handleClearTerminal = () => {
    const id = @activeTerminalId;
    if (id) {
      clearTerminal(id);
    }
  };

  const handleCloseTerminal = (id: string) => {
    closeSession(id);
  };

  const handleSelectTerminal = (id: string) => {
    @activeTab = 'terminal';
    setActiveSession(id);
  };

  <div class="flex flex-col h-full bg-panel-bg">
    <header
      class="flex items-center justify-between h-9 px-2 border-b border-border-default bg-bg-surface"
    >
      <nav class="flex items-center gap-1 min-w-0 overflow-hidden">
        <button
          class={{
            'flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-medium tracking-widest uppercase rounded-t bg-transparent border-none cursor-pointer transition-all duration-150 shrink-0 border-b-2 -mb-px': true,
            'text-text-muted hover:text-text-secondary hover:bg-bg-hover border-b-transparent': @activeTab !==
              'terminal',
            'text-text-primary border-b-accent': @activeTab === 'terminal',
          }}
          onClick={() => (@activeTab = 'terminal')}
        >
          {'TERMINAL'}
        </button>
        <button
          class={{
            'flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-medium tracking-widest uppercase rounded-t bg-transparent border-none cursor-pointer transition-all duration-150 shrink-0 border-b-2 -mb-px': true,
            'text-text-muted hover:text-text-secondary hover:bg-bg-hover border-b-transparent': @activeTab !==
              'problems',
            'text-text-primary border-b-accent': @activeTab === 'problems',
          }}
          onClick={() => (@activeTab = 'problems')}
        >
          {'PROBLEMS'}
          <span class="px-1.5 py-px text-[10px] bg-bg-muted rounded-full">{'0'}</span>
        </button>
        <button
          class={{
            'flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-medium tracking-widest uppercase rounded-t bg-transparent border-none cursor-pointer transition-all duration-150 shrink-0 border-b-2 -mb-px': true,
            'text-text-muted hover:text-text-secondary hover:bg-bg-hover border-b-transparent': @activeTab !== 'output',
            'text-text-primary border-b-accent': @activeTab === 'output',
          }}
          onClick={() => (@activeTab = 'output')}
        >
          {'OUTPUT'}
        </button>

        if (@activeTab === 'terminal' && @terminalSessions.length > 1) {
          <div
            class="flex items-center gap-px ml-2 pl-2 border-l border-border-default overflow-x-auto"
          >
            for (const session of @terminalSessions; key session.id) {
              <button
                class={{
                  'group flex items-center gap-1 px-2 py-1 text-[11px] rounded bg-transparent border-none cursor-pointer transition-all duration-150 shrink-0 max-w-[140px]': true,
                  'text-text-muted hover:text-text-secondary hover:bg-bg-hover': session.id !==
                    @activeTerminalId,
                  'text-text-primary bg-bg-active': session.id === @activeTerminalId,
                }}
                onClick={() => handleSelectTerminal(session.id)}
              >
                <svg class="w-3 h-3 shrink-0 opacity-60" viewBox="0 0 16 16" fill="currentColor">
                  <path
                    d="M0 3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3zm9.5 5.5h-3a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1zm-5.354-2.354a.5.5 0 1 0-.707.708l2 2a.5.5 0 0 0 .707 0l-2-2z"
                  />
                </svg>
                <span class="truncate">{session.name}</span>
                <span
                  class="hidden group-hover:flex items-center justify-center w-3.5 h-3.5 rounded-sm shrink-0 hover:bg-bg-subtle text-text-muted hover:text-text-primary"
                  onClick={(e: Event) => {
                    e.stopPropagation();
                    handleCloseTerminal(session.id);
                  }}
                >
                  <svg class="w-2.5 h-2.5" viewBox="0 0 16 16" fill="currentColor">
                    <path
                      d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"
                    />
                  </svg>
                </span>
              </button>
            }
          </div>
        }
      </nav>

      <div class="flex items-center gap-0.5 shrink-0">
        <div class={{ 'flex items-center gap-0.5': true, hidden: @activeTab !== 'terminal' }}>
          <button
            class="flex items-center justify-center w-6 h-6 rounded border-none bg-transparent text-text-muted cursor-pointer transition-all duration-150 hover:text-text-primary hover:bg-bg-hover"
            title="New Terminal"
            onClick={handleNewTerminal}
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
              <path
                d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"
              />
            </svg>
          </button>
          <button
            class="flex items-center justify-center w-6 h-6 rounded border-none bg-transparent text-text-muted cursor-pointer transition-all duration-150 hover:text-text-primary hover:bg-bg-hover"
            title="Clear Terminal"
            onClick={handleClearTerminal}
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
              <path
                d="M10 12.6l.7.7 1.6-1.6 1.6 1.6.8-.7L13 11l1.7-1.6-.8-.8-1.6 1.7-1.6-1.7-.7.8L11.7 11 10 12.6zM1 4h14V3H1v1zm0 3h14V6H1v1zm8 2.5V9H1v1h8v-.5zM9 13v-1H1v1h8z"
              />
            </svg>
          </button>
        </div>
        <button
          class="flex items-center justify-center w-6 h-6 rounded border-none bg-transparent text-text-muted cursor-pointer transition-all duration-150 hover:text-text-primary hover:bg-bg-hover"
          title="Close Panel (Ctrl+J)"
          onClick={handleClose}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
            <path
              d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"
            />
          </svg>
        </button>
      </div>
    </header>

    <div class="flex-1 min-h-0 overflow-hidden relative">
      <div class={{ 'absolute inset-0': true, hidden: @activeTab !== 'terminal' }}>
        for (const session of @terminalSessions; key session.id) {
          <div class={{ 'absolute inset-0': true, hidden: session.id !== @activeTerminalId }}>
            <Terminal sessionId={session.id} />
          </div>
        }
      </div>
      <div
        class={{
          'absolute inset-0 flex flex-col items-center justify-center text-text-muted text-xs': true,
          hidden: @activeTab !== 'problems',
        }}
      >
        <svg class="w-8 h-8 mb-2 opacity-40 text-success" viewBox="0 0 16 16" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm3.78-9.72a.75.75 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5z"
          />
        </svg>
        <p>{'No problems detected'}</p>
      </div>
      <div
        class={{
          'absolute inset-0 flex flex-col items-center justify-center text-text-muted text-xs': true,
          hidden: @activeTab !== 'output',
        }}
      >
        <p>{'No output'}</p>
      </div>
    </div>
  </div>
}

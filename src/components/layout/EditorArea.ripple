import { track, effect, trackSplit } from 'ripple';
import { EditorTabs } from '../editor/EditorTabs.ripple';
import { Breadcrumbs } from '../editor/Breadcrumbs.ripple';
import { RustEditor } from '../editor/RustEditor.ripple';
import { GoToLineDialog } from '../editor/GoToLineDialog.ripple';
import { SettingsPage } from '../settings/SettingsPage.ripple';
import {
  updateFileContent,
  openFile,
  getActiveFile,
  subscribeToCursorPosition,
  subscribeToGoToLine,
  isSpecialTab,
} from '../../lib/workspace';
import type { OpenFile, CursorPosition } from '../../lib/workspace';
import type { Tracked } from 'ripple';
import { subscribeToAction } from '../../lib/keybindings';
import { editorEngine } from '../../lib/editor-engine';

export component EditorArea(props: {
  activeFileRef?: Tracked<OpenFile | null> | null;
  activeFile?: OpenFile | null;
}) {
  const [activeFileRefProp, rest] = trackSplit(props, ['activeFileRef']);
  const activeFileOverride = (rest as { activeFile?: OpenFile | null }).activeFile;
  // Local state synced from ref + event so template re-renders when active file changes
  // (Ripple may not re-run child template when only a ref's value changes.)
  let fileState = track<OpenFile | null>(
    activeFileOverride !== undefined ? activeFileOverride : (@activeFileRefProp ?? getActiveFile())
  );
  effect(() => {
    const handler = () => {
      if (activeFileOverride === undefined) {
        @fileState = getActiveFile();
      }
    };
    window.addEventListener('workspace-active-file-changed', handler);
    return () => window.removeEventListener('workspace-active-file-changed', handler);
  });
  effect(() => {
    if (activeFileOverride !== undefined) {
      @fileState = activeFileOverride;
    } else {
      const fromRef = @activeFileRefProp;
      const next = fromRef ?? getActiveFile();
      if (next !== @fileState) {
        @fileState = next;
      }
    }
  });
  let currentCursor = track<CursorPosition>({ line: 1, column: 1 });

  // Go to Line dialog state
  let goToLineOpen = track(false);
  let goToLineTarget = track<number | null>(null);

  // Find/Replace state
  let openFind = track(false);
  let openFindReplace = track(false);

  // Focus editor state
  let focusEditor = track(false);

  effect(() => {
    const unsubscribeCursor = subscribeToCursorPosition((pos) => {
      @currentCursor = pos;
    });
    return () => unsubscribeCursor();
  });

  // Subscribe to keybinding action events
  // Note: Save and Close are handled by the global keybinding manager in App.ripple
  effect(() => {
    const unsubscribeGoToLine = subscribeToAction('editor.goToLine', () => {
      const file = getActiveFile();
      if (file && !isSpecialTab(file)) {
        @goToLineOpen = true;
      }
    });

    const unsubscribeFind = subscribeToAction('edit.find', () => {
      const file = getActiveFile();
      if (file && !isSpecialTab(file)) {
        @openFind = true;
      }
    });

    const unsubscribeFindReplace = subscribeToAction('edit.findReplace', () => {
      const file = getActiveFile();
      if (file && !isSpecialTab(file)) {
        @openFindReplace = true;
      }
    });

    const unsubscribeFocusEditor = subscribeToAction('editor.focusEditor', () => {
      const file = getActiveFile();
      if (file && !isSpecialTab(file)) {
        @focusEditor = true;
      }
    });

    const unsubscribeGoToLineExternal = subscribeToGoToLine((line: number) => {
      const file = getActiveFile();
      if (file && !isSpecialTab(file)) {
        @goToLineTarget = line;
      }
    });

    const unsubscribeGoToDefinition = subscribeToAction('editor.goToDefinition', () => {
      const file = getActiveFile();
      if (!file || isSpecialTab(file)) return;
      const bufferId = file.id;
      editorEngine.getSelections(bufferId).then((selSet) => {
        const sel = selSet?.selections?.[selSet.primaryIndex ?? 0] ?? selSet?.selections?.[0];
        if (!sel) return;
        return editorEngine.getLspGotoDefinition(bufferId, sel.headLine, sel.headCol);
      }).then((locations) => {
        if (!locations || locations.length === 0) return;
        const loc = locations[0];
        return openFile(loc.path).then(
          () => editorEngine.setSelections(loc.path, [
            {
              anchorLine: loc.startLine,
              anchorCol: loc.startCharacter,
              headLine: loc.startLine,
              headCol: loc.startCharacter,
            },
          ]),
        );
      }).catch((err) => {
        console.debug('[EditorArea] Go to definition:', err);
      });
    });

    return () => {
      unsubscribeGoToLine();
      unsubscribeFind();
      unsubscribeFindReplace();
      unsubscribeFocusEditor();
      unsubscribeGoToLineExternal();
      unsubscribeGoToDefinition();
    };
  });

  const handleContentChange = (id: string, content: string) => {
    updateFileContent(id, content);
  };

  const handleGoToLine = (line: number) => {
    @goToLineTarget = line;
    @goToLineOpen = false;
  };

  const handleGoToLineClose = () => {
    @goToLineOpen = false;
  };

  const getMaxLines = (file: OpenFile | null) => (file ? file.content.split('\n').length : 1);

  // Consume goToLineTarget for CodeEditor
  const goToLine = @goToLineTarget;

  // Consume find/replace flags for CodeEditor
  const findOpen = @openFind;
  const findReplaceOpen = @openFindReplace;

  // Consume focus editor flag for CodeEditor
  const shouldFocusEditor = @focusEditor;

  // Reset target after it's consumed
  effect(() => {
    if (@goToLineTarget !== null) {
      // Reset after a tick so CodeEditor can consume it
      setTimeout(() => {
        @goToLineTarget = null;
      }, 0);
    }
  });

  // Reset find flag after consumed
  effect(() => {
    if (@openFind) {
      setTimeout(() => {
        @openFind = false;
      }, 0);
    }
  });

  // Reset find/replace flag after consumed
  effect(() => {
    if (@openFindReplace) {
      setTimeout(() => {
        @openFindReplace = false;
      }, 0);
    }
  });

  // Reset focus editor flag after consumed
  effect(() => {
    if (@focusEditor) {
      setTimeout(() => {
        @focusEditor = false;
      }, 0);
    }
  });

  const isSettingsTab = (file: OpenFile | null) => file?.specialTab === 'settings' ||
    file?.specialTab === 'settings-keybindings';

  const getSettingsInitialTab = (file: OpenFile | null) => file?.specialTab ===
  'settings-keybindings'
    ? 'keybindings'
    : 'general';

  const file =
    activeFileOverride !== undefined ? activeFileOverride : @fileState;
  const displayFile = activeFileOverride !== undefined ? activeFileOverride : @fileState;
  // Use @fileState inside the template (not only in displayFile) so Ripple re-runs this block when fileState changes from the workspace-active-file-changed event.
  <div class="flex flex-col h-full bg-editor-bg" data-testid="editor-area" data-current-file-id={(activeFileOverride !== undefined ? activeFileOverride : @fileState)?.id ?? 'null'}>
    <EditorTabs />
    <Breadcrumbs />

    <div class="flex-1 min-h-0 relative">
      if (isSettingsTab(activeFileOverride !== undefined ? activeFileOverride : @fileState)) {
        <div class="absolute inset-0 overflow-auto">
          <SettingsPage initialTab={getSettingsInitialTab(activeFileOverride !== undefined ? activeFileOverride : @fileState)} />
        </div>
      } else if ((activeFileOverride !== undefined ? activeFileOverride : @fileState) && !isSpecialTab(activeFileOverride !== undefined ? activeFileOverride : @fileState)) {
        const currentFile = activeFileOverride !== undefined ? activeFileOverride : @fileState;
        <div class="absolute inset-0" data-testid="editor-container" data-active-file-id={currentFile.id}>
          <RustEditor key={currentFile.id} file={currentFile} onContentChange={handleContentChange} />
        </div>
      } else {
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="flex flex-col items-center text-center max-w-[300px]">
            <svg
              class="w-16 h-16 mb-4 text-text-muted opacity-30"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"
              />
            </svg>
            <h2 class="text-2xl font-medium text-text-primary m-0 mb-2">{'Kode'}</h2>
            <p class="text-[13px] text-text-muted m-0 mb-6">{'No file is open'}</p>
            <div class="flex flex-col gap-2 w-full">
              <div
                class="flex items-center justify-between px-3 py-2 bg-bg-surface rounded-md text-xs"
              >
                <kbd
                  class="px-2 py-0.5 bg-bg-elevated border border-border-default rounded font-mono text-[11px] text-text-secondary"
                >
                  {'Ctrl+P'}
                </kbd>
                <span class="text-text-muted">{'Quick Open'}</span>
              </div>
              <div
                class="flex items-center justify-between px-3 py-2 bg-bg-surface rounded-md text-xs"
              >
                <kbd
                  class="px-2 py-0.5 bg-bg-elevated border border-border-default rounded font-mono text-[11px] text-text-secondary"
                >
                  {'Ctrl+,'}
                </kbd>
                <span class="text-text-muted">{'Settings'}</span>
              </div>
              <div
                class="flex items-center justify-between px-3 py-2 bg-bg-surface rounded-md text-xs"
              >
                <kbd
                  class="px-2 py-0.5 bg-bg-elevated border border-border-default rounded font-mono text-[11px] text-text-secondary"
                >
                  {'Ctrl+`'}
                </kbd>
                <span class="text-text-muted">{'Toggle Terminal'}</span>
              </div>
            </div>
          </div>
        </div>
      }
    </div>

    <GoToLineDialog
      isOpen={goToLineOpen}
      maxLine={getMaxLines(file)}
      currentLine={@currentCursor.line}
      onGoToLine={handleGoToLine}
      onClose={handleGoToLineClose}
    />
  </div>
}

import { track, effect } from 'ripple';
import { currentMode, resolvedTheme, cycleTheme, subscribe, type ThemeMode } from '../../lib/theme';
import {
  cursorPosition,
  subscribeToCursorPosition,
  subscribeToActiveFile,
  getActiveFile,
  subscribeToWorkspacePath,
  subscribeToFileInfo,
  currentFileInfo,
  workspacePath,
} from '../../lib/workspace';
import type { CursorPosition, FileInfo } from '../../lib/workspace';
import { editorEngine } from '../../lib/editor-engine';
import { subscribeToZoom, getZoomPercentage, resetZoom } from '../../lib/zoom';
import { git } from '../../lib/tauri';

export component StatusBar() {
  let themeMode = track<ThemeMode>(currentMode);
  let themeName = track<'light' | 'dark'>(resolvedTheme);
  let gitBranch = track<string | null>(null);
  let position = track<CursorPosition>({ ...cursorPosition });
  let encoding = track(currentFileInfo.encoding);
  let lineEnding = track(currentFileInfo.lineEnding);
  let language = track<string>('Plain Text');
  let lspActive = track(false);
  let zoomLevel = track(100);

  // Subscribe to theme changes
  effect(() => {
    const unsubscribe = subscribe((config) => {
      @themeMode = config.mode;
      @themeName = config.resolvedTheme;
    });
    return unsubscribe;
  });

  // Subscribe to cursor position changes
  effect(() => {
    const unsubscribe = subscribeToCursorPosition((pos) => {
      @position = { ...pos };
    });
    return unsubscribe;
  });

  // Subscribe to active file changes to update language and LSP indicator
  effect(() => {
    let lspCheckTimeouts: ReturnType<typeof setTimeout>[] = [];

    const checkLsp = (path: string, onlyIfStillActive = false) => {
      editorEngine.getLspHasSession(path).then((hasSession) => {
        if (onlyIfStillActive && getActiveFile()?.path !== path) return;
        @lspActive = hasSession;
      }).catch(() => {
        if (onlyIfStillActive && getActiveFile()?.path !== path) return;
        @lspActive = false;
      });
    };

    const unsubscribe = subscribeToActiveFile(() => {
      for (const t of lspCheckTimeouts) clearTimeout(t);
      lspCheckTimeouts = [];

      const activeFile = getActiveFile();
      if (activeFile) {
        const path = activeFile.path;
        @language = getDisplayLanguage(activeFile.language);
        @lspSupported = lspSupportedLanguages.has(activeFile.language);
        checkLsp(path);
        // Session is created asynchronously after didOpen; re-query so indicator appears once ready
        const t1 = setTimeout(() => checkLsp(path, true), 600);
        const t2 = setTimeout(() => checkLsp(path, true), 1500);
        lspCheckTimeouts = [t1, t2];
      } else {
        @language = 'Plain Text';
        @lspSupported = false;
        @lspActive = false;
      }
    });

    return () => {
      for (const t of lspCheckTimeouts) clearTimeout(t);
      unsubscribe();
    };
  });

  // Subscribe to zoom level changes
  effect(() => {
    const unsubscribe = subscribeToZoom(() => {
      @zoomLevel = getZoomPercentage();
    });
    return unsubscribe;
  });

  // Subscribe to file info changes (line endings, encoding)
  effect(() => {
    const unsubscribe = subscribeToFileInfo((info: FileInfo) => {
      @encoding = info.encoding;
      @lineEnding = info.lineEnding;
    });
    return unsubscribe;
  });

  // Subscribe to workspace path changes to fetch git branch
  effect(() => {
    const fetchBranch = (path: string | null) => {
      if (path) {
        git.getBranch(path).then((branch) => {
          @gitBranch = branch;
        }).catch(() => {
          @gitBranch = null;
        });
      } else {
        @gitBranch = null;
      }
    };

    // Fetch initial branch
    fetchBranch(workspacePath);

    const unsubscribe = subscribeToWorkspacePath((path) => {
      fetchBranch(path);
    });
    return unsubscribe;
  });

  const getDisplayLanguage = (lang: string): string => {
    const displayMap: Record<string, string> = {
      typescript: 'TypeScript',
      javascript: 'JavaScript',
      json: 'JSON',
      markdown: 'Markdown',
      css: 'CSS',
      html: 'HTML',
      rust: 'Rust',
      python: 'Python',
      toml: 'TOML',
      yaml: 'YAML',
      text: 'Plain Text',
    };
    return displayMap[lang] || lang;
  };

  const lspSupportedLanguages = new Set(['typescript', 'javascript', 'rust', 'python', 'json']);
  let lspSupported = track(false);

  const handleThemeToggle = () => {
    cycleTheme();
  };

  const getThemeIcon = () => {
    if (@themeMode === 'system') return 'laptop';
    if (@themeName === 'dark') return 'moon';
    return 'sun';
  };

  <footer
    class="flex items-center justify-between h-[22px] px-2 bg-statusbar-bg text-statusbar-text text-[11px] shrink-0"
  >
    <div class="flex items-center gap-0.5">
      <button
        class={{
          'flex items-center gap-1 px-1.5 h-[22px] bg-transparent border-none text-inherit text-[11px] cursor-pointer rounded-sm hover:bg-white/10': true,
          hidden: !@gitBranch,
        }}
        title="Source Control"
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path
            d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25zM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0z"
          />
        </svg>
        <span>{@gitBranch}</span>
      </button>

      <span class="flex items-center gap-1 px-1.5 h-[22px] whitespace-nowrap" title="No Problems">
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm3.78-9.72a.75.75 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5z"
          />
        </svg>
        <span>{'0'}</span>
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path
            d="M6.457 1.047c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0 1 14.082 15H1.918a1.75 1.75 0 0 1-1.543-2.575L6.457 1.047zM8 5a.75.75 0 0 0-.75.75v2.5a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8 5zm1 6a1 1 0 1 0-2 0 1 1 0 0 0 2 0z"
          />
        </svg>
        <span>{'0'}</span>
      </span>
    </div>

    <div class="flex items-center gap-0.5">
      <span class="flex items-center gap-1 px-1.5 h-[22px] whitespace-nowrap">
        {'Ln '}
        {@position.line}
        {', Col '}
        {@position.column}
      </span>

      <span class="flex items-center gap-1 px-1.5 h-[22px] whitespace-nowrap">{@encoding}</span>

      <span class="flex items-center gap-1 px-1.5 h-[22px] whitespace-nowrap">{@lineEnding}</span>

      <button
        class="flex items-center gap-1 px-1.5 h-[22px] bg-transparent border-none text-inherit text-[11px] cursor-pointer rounded-sm hover:bg-white/10 whitespace-nowrap"
        onClick={() => resetZoom()}
        title={'Zoom: ' + @zoomLevel + '% (click to reset)'}
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path
            d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"
          />
        </svg>
        <span>
          {@zoomLevel}
          {'%'}
        </span>
      </button>

      <button
        class="flex items-center gap-1 px-1.5 h-[22px] bg-transparent border-none text-inherit text-[11px] cursor-pointer rounded-sm hover:bg-white/10 whitespace-nowrap"
        onClick={handleThemeToggle}
        title={'Theme: ' + @themeMode + ' (' + @themeName + ')'}
      >
        <svg
          class={{ 'w-3.5 h-3.5 shrink-0': true, hidden: getThemeIcon() !== 'sun' }}
          viewBox="0 0 16 16"
          fill="currentColor"
        >
          <path
            d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z"
          />
        </svg>
        <svg
          class={{ 'w-3.5 h-3.5 shrink-0': true, hidden: getThemeIcon() !== 'moon' }}
          viewBox="0 0 16 16"
          fill="currentColor"
        >
          <path
            d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"
          />
        </svg>
        <svg
          class={{ 'w-3.5 h-3.5 shrink-0': true, hidden: getThemeIcon() !== 'laptop' }}
          viewBox="0 0 16 16"
          fill="currentColor"
        >
          <path
            d="M13.5 3a.5.5 0 0 1 .5.5V11H2V3.5a.5.5 0 0 1 .5-.5h11zm-11-1A1.5 1.5 0 0 0 1 3.5V12h14V3.5A1.5 1.5 0 0 0 13.5 2h-11zM0 12.5h16a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 12.5z"
          />
        </svg>
        <span>{@themeMode === 'system' ? 'Auto' : @themeName === 'dark' ? 'Dark' : 'Light'}</span>
      </button>

      <span
        class="flex items-center gap-1 cursor-pointer px-1.5 h-[22px] whitespace-nowrap"
        title={@lspActive
          ? 'Language server active (diagnostics, completion, hover)'
          : @lspSupported
            ? 'LSP Language Server missing for this language'
            : undefined}
      >
        {@language}
        if (@lspSupported) {
          <span class={{ 'text-amber-500': !@lspActive }}>{' - LSP'}</span>
        }
      </span>
    </div>
  </footer>
}

import { track, effect } from 'ripple';
import { FileTree } from '../filetree/FileTree.ripple';
import { SourceControl } from '../git/SourceControl.ripple';
import { openFile, workspacePath, requestGoToLine } from '../../lib/workspace';
import { subscribeToAction } from '../../lib/keybindings';
import { fs, type ContentMatch } from '../../lib/tauri';
import type { ActivityTab } from './ActivityBar.ripple';

// Group search results by file path
interface FileGroup {
  path: string;
  fileName: string;
  matches: ContentMatch[];
  isCollapsed: boolean;
}

export component Sidebar(props: { activeTab: ActivityTab }) {

  // Search state
  let searchQuery = track('');
  let searchResults = track<ContentMatch[]>([]);
  let fileGroups = track<FileGroup[]>([]);
  let isSearching = track(false);
  let totalMatches = track(0);
  let totalFiles = track(0);
  let searchInputRef = track<HTMLInputElement | null>(null);
  let searchTimeout: number | null = null;

  // Subscribe to edit.findInFiles action - focus search input when switching to search
  effect(() => {
    const unsub = subscribeToAction('edit.findInFiles', () => {
      // Focus the search input after a microtask to let the DOM update
      setTimeout(() => {
        if (@searchInputRef) {
          @searchInputRef.focus();
          @searchInputRef.select();
        }
      }, 0);
    });
    return () => unsub();
  });

  // Debounced search effect
  effect(() => {
    const q = @searchQuery;
    const root = workspacePath;

    if (searchTimeout) {
      clearTimeout(searchTimeout);
      searchTimeout = null;
    }

    if (!q.trim() || !root) {
      @searchResults = [];
      @fileGroups = [];
      @totalMatches = 0;
      @totalFiles = 0;
      @isSearching = false;
      return () => {};
    }

    @isSearching = true;

    const id = setTimeout(async () => {
      try {
        const results = await fs.searchContent(root, q, 200);
        @searchResults = results;

        // Group results by file
        const groupMap = new Map<string, FileGroup>();
        for (const match of results) {
          let group = groupMap.get(match.path);
          if (!group) {
            const parts = match.path.split('/');
            group = {
              path: match.path,
              fileName: parts[parts.length - 1] || match.path,
              matches: [],
              isCollapsed: false,
            };
            groupMap.set(match.path, group);
          }
          group.matches.push(match);
        }

        @fileGroups = Array.from(groupMap.values());
        @totalMatches = results.length;
        @totalFiles = groupMap.size;
      } catch (error) {
        console.error('Search failed:', error);
        @searchResults = [];
        @fileGroups = [];
        @totalMatches = 0;
        @totalFiles = 0;
      } finally {
        @isSearching = false;
      }
    }, 200) as unknown as number;
    searchTimeout = id;

    return () => {
      if (searchTimeout) {
        clearTimeout(searchTimeout);
        searchTimeout = null;
      }
    };
  });

  const getRelativePath = (fullPath: string) => {
    const root = workspacePath;
    if (root && fullPath.startsWith(root)) {
      const rel = fullPath.slice(root.length + 1);
      // Return the directory part only (without file name)
      const lastSlash = rel.lastIndexOf('/');
      return lastSlash >= 0 ? rel.slice(0, lastSlash) : '';
    }
    return fullPath;
  };

  const handleResultClick = (match: ContentMatch) => {
    const parts = match.path.split('/');
    const name = parts[parts.length - 1] || match.path;
    openFile(match.path, name);
    // Navigate to the matching line after a short delay to let the editor mount
    setTimeout(() => {
      requestGoToLine(match.line_number);
    }, 50);
  };

  const toggleGroup = (group: FileGroup) => {
    const index = @fileGroups.findIndex((g) => g.path === group.path);
    if (index !== -1) {
      @fileGroups[index] = { ...group, isCollapsed: !group.isCollapsed };
    }
  };

  const handleSearchKeyDown = (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      @searchQuery = '';
      if (@searchInputRef) {
        @searchInputRef.blur();
      }
    }
  };

  <div class="flex h-full bg-sidebar-bg flex-1 min-w-0 overflow-hidden">
      <div class={{ 'flex flex-col h-full w-full flex-1 min-w-0 overflow-hidden': true, hidden: @props.activeTab !== 'explorer' }}>
        <FileTree />
      </div>

      <div class={{ 'flex flex-col h-full w-full flex-1 min-w-0 overflow-hidden': true, hidden: @props.activeTab !== 'search' }}>
        <header class="flex items-center px-4 pt-3 pb-2">
          <span class="text-[11px] font-semibold text-text-secondary tracking-wider">
            {'SEARCH'}
          </span>
        </header>

        <div class="px-3 pb-2">
          <div class="relative">
            <svg
              class="absolute left-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-muted pointer-events-none"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"
              />
            </svg>
            <input
              type="text"
              placeholder="Search in files..."
              class="w-full pl-7 pr-2.5 py-1.5 text-xs bg-bg-elevated border border-border-default rounded text-text-primary outline-none transition-colors duration-150 focus:border-accent placeholder:text-text-muted"
              value={@searchQuery}
              onInput={(e: InputEvent) => (@searchQuery = (e.target as HTMLInputElement).value)}
              onKeyDown={handleSearchKeyDown}
              ref={(el: HTMLInputElement) => {
                @searchInputRef = el;
                return () => {
                  @searchInputRef = null;
                };
              }}
            />
            if (@isSearching) {
              <svg
                class="absolute right-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-muted animate-spin"
                viewBox="0 0 16 16"
                fill="none"
              >
                <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" opacity="0.25" />
                <path
                  d="M14 8a6 6 0 0 0-6-6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            }
          </div>
        </div>

        if (@searchQuery.trim() && @totalMatches > 0) {
          <div class="px-3 pb-1.5">
            <span class="text-[11px] text-text-muted">
              {@totalMatches}
              {@totalMatches === 1 ? ' result' : ' results'}
              {' in '}
              {@totalFiles}
              {@totalFiles === 1 ? ' file' : ' files'}
            </span>
          </div>
        }

        <div class="flex-1 overflow-auto">
          if (!@searchQuery.trim()) {
            <div
              class="flex flex-col items-center justify-center px-4 py-8 text-center text-text-muted text-xs"
            >
              <svg class="w-10 h-10 mb-3 opacity-20" viewBox="0 0 16 16" fill="currentColor">
                <path
                  d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"
                />
              </svg>
              <p>{'Type to search across files'}</p>
            </div>
          }

          if (@searchQuery.trim() && !@isSearching && @totalMatches === 0) {
            <div
              class="flex flex-col items-center justify-center px-4 py-8 text-center text-text-muted text-xs"
            >
              <p>{'No results found'}</p>
            </div>
          }

          if (@searchQuery.trim() && @isSearching && @totalMatches === 0) {
            <div
              class="flex flex-col items-center justify-center px-4 py-8 text-center text-text-muted text-xs"
            >
              <p>{'Searching...'}</p>
            </div>
          }

          for (const group of @fileGroups; index gi) {
            <div class="border-b border-border-default/50 last:border-b-0">
              <button
                class="flex items-center gap-1.5 w-full px-3 py-1.5 text-left hover:bg-bg-hover transition-colors duration-100 cursor-pointer bg-transparent border-none"
                onClick={() => toggleGroup(group)}
              >
                <svg
                  class={{
                    'w-3 h-3 text-text-muted shrink-0 transition-transform duration-150': true,
                    'rotate-90': !group.isCollapsed,
                  }}
                  viewBox="0 0 16 16"
                  fill="currentColor"
                >
                  <path d="M6 4l4 4-4 4z" />
                </svg>
                <svg
                  class="w-3.5 h-3.5 text-text-muted shrink-0"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                >
                  <path
                    d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75z"
                  />
                </svg>
                <span class="text-xs text-text-primary truncate flex-1">{group.fileName}</span>
                <span
                  class="text-[10px] text-text-muted shrink-0 bg-bg-elevated px-1.5 py-px rounded-full"
                >
                  {String(group.matches.length)}
                </span>
              </button>

              if (!group.isCollapsed) {
                <div class="pl-5">
                  for (const match of group.matches; index mi) {
                    <button
                      class="flex items-start gap-1.5 w-full px-2 py-1 text-left hover:bg-bg-hover transition-colors duration-100 cursor-pointer bg-transparent border-none group"
                      onClick={() => handleResultClick(match)}
                      title={getRelativePath(match.path)}
                    >
                      <span
                        class="text-[10px] text-text-muted shrink-0 font-mono w-6 text-right pt-px"
                      >
                        {String(match.line_number)}
                      </span>
                      <span
                        class="text-xs text-text-secondary truncate flex-1 font-mono leading-relaxed"
                      >
                        {match.line_content.trim()}
                      </span>
                    </button>
                  }
                </div>
              }
            </div>
          }
        </div>
      </div>

      <div class={{ 'flex flex-col h-full w-full flex-1 min-w-0 overflow-hidden': true, hidden: @props.activeTab !== 'git' }}>
        <SourceControl />
      </div>
  </div>
}

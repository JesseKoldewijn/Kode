import { track } from 'ripple';

export component EditorInput(props: {
  onInput: (text: string) => void;
  onKeyDown: (e: KeyboardEvent) => void;
  onReady?: (el: HTMLTextAreaElement) => void;
}) {
  let textarea = track<HTMLTextAreaElement | null>(null);

  const onInput = (e: InputEvent) => {
    const text = (e.target as HTMLTextAreaElement).value;
    if (text) {
      props.onInput(text);
      (e.target as HTMLTextAreaElement).value = '';
    }
  };

  const handleRef = (el: HTMLTextAreaElement) => {
    @textarea = el;
    if (el && props.onReady) {
      props.onReady(el);
    }
  };

  <textarea
    {ref handleRef}
    class="absolute opacity-0 pointer-events-none z-[-1]"
    onInput={onInput}
    onKeyDown={props.onKeyDown}
    autocapitalize="off"
    autocorrect="off"
    spellcheck={false}
  />
}

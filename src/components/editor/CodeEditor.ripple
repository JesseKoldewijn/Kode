import { effect, track } from 'ripple';
import { monaco } from '../../lib/monaco-workers';
import { registerMonacoThemes, setMonacoTheme, getMonacoThemeName } from '../../lib/monaco-theme';
import { subscribe as subscribeToTheme, resolvedTheme } from '../../lib/theme';
import {
  subscribeToEditorSettings,
  currentSettings,
  type EditorSettings,
} from '../../lib/editor-settings';
import { setCursorPosition, getLanguageFromPath, subscribeToGoToLine } from '../../lib/workspace';
import type { OpenFile } from '../../lib/workspace';

// Language mapping from workspace language names to Monaco language IDs
const MONACO_LANGUAGE_MAP: Record<string, string> = {
  typescript: 'typescript',
  javascript: 'javascript',
  json: 'json',
  markdown: 'markdown',
  css: 'css',
  html: 'html',
  rust: 'rust',
  python: 'python',
  toml: 'ini', // Monaco doesn't have native TOML, use INI as fallback
  yaml: 'yaml',
  text: 'plaintext',
};

// Get Monaco language ID from workspace language
function getMonacoLanguage(lang: string): string {
  return MONACO_LANGUAGE_MAP[lang] || 'plaintext';
}

// Register Monaco themes once at module load
let themesRegistered = false;
function ensureThemesRegistered(): void {
  if (!themesRegistered) {
    registerMonacoThemes();
    themesRegistered = true;
  }
}

export component CodeEditor(props: {
  file: OpenFile | null;
  onContentChange: (id: string, content: string) => void;
  goToLine?: number | null;
  openFind?: boolean;
  openFindReplace?: boolean;
  focusEditor?: boolean;
}) {
  let container = track<HTMLDivElement | null>(null);
  let containerReady = track(false);
  let editor = track<monaco.editor.IStandaloneCodeEditor | null>(null);
  let isUpdatingFromExternal = track(false);

  // Track current file ID to detect file switches
  let currentFileId = track<string | null>(null);

  // Ref callback for container element
  const containerRef = (el: HTMLDivElement) => {
    console.log('[CodeEditor] containerRef called', { hasElement: !!el, timestamp: Date.now() });
    @container = el;
    @containerReady = true;
    return () => {
      console.log('[CodeEditor] containerRef cleanup');
      @containerReady = false;
      @container = null;
    };
  };

  // Initialize Monaco editor
  let effectRunCount = 0;
  effect(() => {
    effectRunCount++;
    console.log('[CodeEditor] Effect run #' + effectRunCount, {
      ready: @containerReady,
      hasContainer: !!@container,
      timestamp: Date.now(),
    });

    if (!@containerReady) {
      console.log('[CodeEditor] Container not ready, skipping');
      return;
    }

    const containerElement = @container;
    if (!containerElement) {
      console.log('[CodeEditor] No container element, skipping Monaco initialization');
      return;
    }

    console.log('[CodeEditor] Initializing Monaco editor...', {
      container: containerElement,
      containerDimensions: containerElement.getBoundingClientRect(),
      file: props.file?.name,
      fileContent: props.file?.content?.substring(0, 100),
      fileLanguage: props.file?.language,
    });

    ensureThemesRegistered();

    // Create the editor instance
    const editorInstance = monaco.editor.create(containerElement, {
      value: props.file?.content || '',
      language: props.file ? getMonacoLanguage(props.file.language) : 'plaintext',
      theme: getMonacoThemeName(resolvedTheme),
      automaticLayout: true,
      fontSize: 13,
      fontFamily: 'ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace',
      lineHeight: 20,
      tabSize: currentSettings.tabSize,
      wordWrap: currentSettings.wordWrap ? 'on' : 'off',
      minimap: {
        enabled: true,
        maxColumn: 80,
      },
      scrollBeyondLastLine: false,
      renderLineHighlight: 'line',
      cursorBlinking: 'smooth',
      cursorSmoothCaretAnimation: 'on',
      smoothScrolling: true,
      padding: { top: 8, bottom: 8 },
      folding: true,
      foldingStrategy: 'indentation',
      showFoldingControls: 'mouseover',
      bracketPairColorization: { enabled: true },
      guides: {
        bracketPairs: true,
        indentation: true,
      },
      fixedOverflowWidgets: true,
    });

    console.log('[CodeEditor] Monaco instance created:', {
      hasEditor: !!editorInstance,
      domElement: editorInstance.getDomNode(),
      model: editorInstance.getModel(),
      value: editorInstance.getValue().substring(0, 100),
    });

    @editor = editorInstance;
    @currentFileId = props.file?.id || null;

    // Set initial cursor position
    if (props.file) {
      setCursorPosition(1, 1);
    }

    // Listen for content changes
    const contentDisposable = editorInstance.onDidChangeModelContent(() => {
      if (@isUpdatingFromExternal) return;

      const value = editorInstance.getValue();
      if (props.file) {
        props.onContentChange(props.file.id, value);
      }
    });

    // Listen for cursor position changes
    const cursorDisposable = editorInstance.onDidChangeCursorPosition((e) => {
      setCursorPosition(e.position.lineNumber, e.position.column);
    });

    // Subscribe to theme changes
    const unsubTheme = subscribeToTheme((config) => {
      setMonacoTheme(config.resolvedTheme);
    });

    // Subscribe to editor settings changes
    const unsubSettings = subscribeToEditorSettings((settings: EditorSettings) => {
      editorInstance.updateOptions(
        {
          tabSize: settings.tabSize,
          wordWrap: settings.wordWrap ? 'on' : 'off',
        },
      );
    });

    // Subscribe to go-to-line requests
    const unsubGoToLine = subscribeToGoToLine((line: number) => {
      editorInstance.setPosition({ lineNumber: line, column: 1 });
      editorInstance.revealLineInCenter(line);
      editorInstance.focus();
    });

    // Cleanup on unmount
    return () => {
      contentDisposable.dispose();
      cursorDisposable.dispose();
      unsubTheme();
      unsubSettings();
      unsubGoToLine();
      editorInstance.dispose();
      @editor = null;
    };
  });

  // Handle file changes (switch between files)
  effect(() => {
    const editorInstance = @editor;
    if (!editorInstance) return;

    const file = props.file;
    const prevFileId = @currentFileId;

    // File switched or content updated externally
    if (file && file.id !== prevFileId) {
      @isUpdatingFromExternal = true;
      @currentFileId = file.id;

      // Update content
      editorInstance.setValue(file.content);

      // Update language
      const model = editorInstance.getModel();
      if (model) {
        monaco.editor.setModelLanguage(model, getMonacoLanguage(file.language));
      }

      // Reset cursor to start
      editorInstance.setPosition({ lineNumber: 1, column: 1 });
      editorInstance.setScrollPosition({ scrollTop: 0, scrollLeft: 0 });
      setCursorPosition(1, 1);

      @isUpdatingFromExternal = false;
    } else if (file && file.id === prevFileId) {
      // Same file, but content might have changed externally (e.g., file reload)
      const currentContent = editorInstance.getValue();
      if (currentContent !== file.content) {
        @isUpdatingFromExternal = true;
        // Save cursor position before update
        const position = editorInstance.getPosition();
        const scrollTop = editorInstance.getScrollTop();

        editorInstance.setValue(file.content);

        // Restore cursor position
        if (position) {
          editorInstance.setPosition(position);
          editorInstance.setScrollTop(scrollTop);
        }
        @isUpdatingFromExternal = false;
      }
    } else if (!file) {
      // No file selected - clear content
      @isUpdatingFromExternal = true;
      editorInstance.setValue('');
      @currentFileId = null;
      @isUpdatingFromExternal = false;
    }
  });

  // Handle goToLine prop
  effect(() => {
    const editorInstance = @editor;
    const line = props.goToLine;

    if (editorInstance && line !== null && line !== undefined) {
      editorInstance.setPosition({ lineNumber: line, column: 1 });
      editorInstance.revealLineInCenter(line);
      editorInstance.focus();
    }
  });

  // Handle openFind prop
  effect(() => {
    const editorInstance = @editor;
    if (editorInstance && props.openFind) {
      editorInstance.trigger('keyboard', 'actions.find', null);
    }
  });

  // Handle openFindReplace prop
  effect(() => {
    const editorInstance = @editor;
    if (editorInstance && props.openFindReplace) {
      editorInstance.trigger('keyboard', 'editor.action.startFindReplaceAction', null);
    }
  });

  // Handle focusEditor prop
  effect(() => {
    const editorInstance = @editor;
    if (editorInstance && props.focusEditor) {
      editorInstance.focus();
    }
  });

  <div class="h-full w-full overflow-hidden" data-testid="editor-container" {ref containerRef} />
}

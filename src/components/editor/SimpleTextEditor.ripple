import type { OpenFile } from '../../lib/workspace';

export component SimpleTextEditor(props: {
  file: OpenFile | null;
  onContentChange: (id: string, content: string) => void;
}) {
  console.log('[SimpleTextEditor] Render', { 
    hasFile: !!props.file, 
    fileId: props.file?.id,
    contentLength: props.file?.content?.length 
  });

  if (!props.file) {
    <div class="flex items-center justify-center h-full text-gray-500">
      {"No file open"}
    </div>
  } else {
    const handleInput = (e: Event) => {
      const target = e.target as HTMLTextAreaElement;
      console.log('[SimpleTextEditor] Content changed', { 
        fileId: props.file?.id,
        newLength: target.value.length 
      });
      if (props.file) {
        props.onContentChange(props.file.id, target.value);
      }
    };

    <div class="h-full flex flex-col bg-[--color-editor-bg] text-[--color-editor-fg]">
      <div class="px-4 py-2 border-b border-[--color-border] bg-[--color-bg-secondary] font-mono text-sm">
        {"File: "}{props.file.path}{" ("}{props.file.content.length}{" chars)"}
      </div>
      <textarea
        class="flex-1 p-4 font-mono text-sm resize-none outline-none bg-[--color-editor-bg] text-[--color-editor-fg]"
        value={props.file.content}
        onInput={handleInput}
        placeholder={"File content will appear here..."}
      />
    </div>
  }
}

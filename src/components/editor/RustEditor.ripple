import { track, effect, trackSplit, set as rippleSet } from 'ripple';
import {
  editorEngine,
  type ViewportHighlights,
  type Selection,
  type FoldRange,
  type LspCompletionItem,
  type LspSignatureHelp,
  type LspSignatureInformation,
} from '../../lib/editor-engine';
import { EditorViewport } from './EditorViewport.ripple';
import { EditorInput } from './EditorInput.ripple';
import { EditorMinimap } from './EditorMinimap.ripple';
import { EditorOverlay } from './EditorOverlay.ripple';
import { EditorGutter } from './EditorGutter.ripple';
import type { OpenFile } from '../../lib/workspace';
import { setCursorPosition, getActiveFile } from '../../lib/workspace';
import { subscribeToAction } from '../../lib/keybindings';
import { currentSettings as editorSettings } from '../../lib/editor-settings';

export component RustEditor(props: {
  file: OpenFile | null;
  onContentChange: (id: string, content: string) => void;
}) {
  const [fileProp, restProps] = trackSplit(props, ['file']);
  // Internal file state; sync from reactive file prop when parent passes a different file (tab switch)
  let file = track<OpenFile | null>(@fileProp ?? getActiveFile());

  // Sync @file from reactive prop when parent passes a different file (tab switch or second file open)
  effect(() => {
    const next = @fileProp ?? getActiveFile();
    if (next?.id !== @file?.id) {
      rippleSet(file, next ?? null);
    } else if (!next && @file) {
      rippleSet(file, null);
    }
  });

  let scrollTop = track(0);
  let containerHeight = track(0);
  let container = track<HTMLDivElement | null>(null);
  let selections = track<Selection[]>([
    { anchorLine: 0, anchorCol: 0, headLine: 0, headCol: 0 },
  ]);
  let isMouseDown = track(false);
  let localContent = track<string | null>(@file?.content ?? null);
  let serverVersion = track(0);
  let pendingEdits = track(0);
  let currentFileId = track<string | null>(@file?.id ?? null);
  let mouseMoveThrottleTimer: number | null = null;
  let showFindOverlay = track(false);
  let showCompletion = track(false);
  let completionItems = track<LspCompletionItem[]>([]);
  let completionSelectedIndex = track(0);
  let showSignatureHelp = track(false);
  let signatureHelp = track<LspSignatureHelp | null>(null);
  let selectedSignatureIndex = track(0);
  let minimapTotalLines = track(1);
  let minimapStartLine = track(0);
  let minimapLineCount = track(0);
  let foldRanges = track<FoldRange[] | null>(null);
  let foldedStartLines = track<number[]>([]);
  let wordWrap = track(false);
  let inputTextarea = track<HTMLTextAreaElement | null>(null);

  // Initialize/reset local content when file or fileProp changes (re-runs when @file or @fileProp changes).
  // Use rippleSet so updates propagate in same flush when tab is switched via flushSync.
  effect(() => {
    const fromProp = @fileProp ?? getActiveFile();
    const currentFile = @file ?? fromProp;
    if (currentFile) {
      if (@currentFileId !== currentFile.id) {
        rippleSet(file, currentFile);
        rippleSet(localContent, currentFile.content);
        rippleSet(serverVersion, 0);
        rippleSet(pendingEdits, 0);
        rippleSet(scrollTop, 0);
        rippleSet(selections, [
          { anchorLine: 0, anchorCol: 0, headLine: 0, headCol: 0 },
        ]);
        rippleSet(currentFileId, currentFile.id);
        rippleSet(foldRanges, null);
        rippleSet(foldedStartLines, []);
      }
    } else {
      rippleSet(localContent, null);
      rippleSet(currentFileId, null);
    }
  });

  // Load fold ranges when buffer is available
  effect(() => {
    const currentFile = @file;
    if (!currentFile) {
      @foldRanges = null;
      @foldedStartLines = [];
      return;
    }

    const bufferId = currentFile.id;
    editorEngine.getFoldRanges(bufferId).then((ranges) => {
      @foldRanges = ranges;
    }).catch((err) => {
      console.warn('[RustEditor] Failed to load fold ranges', err);
    });
  });

  const toggleFoldAtLine = (line: number) => {
    const current = new Set(@foldedStartLines);
    if (current.has(line)) {
      current.delete(line);
    } else {
      current.add(line);
    }
    @foldedStartLines = Array.from(current).sort((a, b) => a - b);
  };

  /** Sync local state to @file when tab switched (effect may not have run yet). */
  const syncToCurrentFile = () => {
    if (!@file || @currentFileId === @file.id) return;
    @currentFileId = @file.id;
    @localContent = @file.content;
    @serverVersion = 0;
    @pendingEdits = 0;
    @selections = [
      { anchorLine: 0, anchorCol: 0, headLine: 0, headCol: 0 },
    ];
  };

  // Scroll to cursor when selection changes
  effect(() => {
    if (@selections.length === 0 || !@container) {
      return;
    }

    const currentSel = @selections[0];
    const cursorLine = currentSel.headLine;
    const lineHeight = 20;

    // Update status bar cursor position (1-indexed for display)
    setCursorPosition(cursorLine + 1, currentSel.headCol + 1);

    const cursorTop = cursorLine * lineHeight;
    const cursorBottom = cursorTop + lineHeight;
    const viewportTop = @scrollTop;
    const viewportBottom = viewportTop + @containerHeight;

    // Scroll if cursor is outside viewport
    if (cursorTop < viewportTop) {
      // Cursor is above viewport - scroll up
      @container.scrollTop = cursorTop;
    } else if (cursorBottom > viewportBottom) {
      // Cursor is below viewport - scroll down
      @container.scrollTop = cursorBottom - @containerHeight;
    }
  });

  const onScroll = (e: Event) => {
    @scrollTop = (e.target as HTMLDivElement).scrollTop;
  };

  const jumpToLine = (line: number) => {
    if (!@container) return;
    const lineHeight = 20;
    @container.scrollTop = line * lineHeight;
  };

  // Keep minimap metrics in sync with content and viewport
  effect(() => {
    const baseContent =
      @file && @currentFileId === @file.id
        ? @localContent ?? @file.content ?? ''
        : (@file ? @file.content ?? '' : '');

    const total =
      baseContent === '' ? 1 : baseContent.split('\n').length;
    const start = Math.floor(@scrollTop / 20);
    // Use real viewport line count; enforce a minimum so gutter never shows just one line (e.g. before layout or tiny container)
    const effectiveHeight = Math.max(@containerHeight, 400);
    const count =
      effectiveHeight > 0 ? Math.ceil(effectiveHeight / 20) : Math.min(100, Math.max(1, total));
    const countClamped = Math.min(count, total);

    @minimapTotalLines = total;
    @minimapStartLine = start;
    @minimapLineCount = countClamped;
  });

  // Subscribe to word wrap toggle action
  effect(() => {
    const unsubscribe = subscribeToAction('editor.toggleWordWrap', () => {
      @wordWrap = !@wordWrap;
    });
    return () => unsubscribe();
  });

  const applyLocalEdit = (
    range: { startLine: number; startCol: number; endLine: number; endCol: number },
    newText: string,
  ) => {
    if (!@localContent) return;

    const lines = @localContent.split('\n');

    // Extract text before the edit range
    const beforeLines = lines.slice(0, range.startLine);
    const startLineText = lines[range.startLine] || '';
    const beforeText =
      beforeLines.join('\n') + (beforeLines.length > 0 ? '\n' : '') +
      startLineText.substring(0, range.startCol);

    // Extract text after the edit range
    const endLineText = lines[range.endLine] || '';
    const afterText = endLineText.substring(range.endCol);
    const afterLines = lines.slice(range.endLine + 1);
    const afterFullText = afterText + (afterLines.length > 0 ? '\n' + afterLines.join('\n') : '');

    // Combine: before + newText + after
    @localContent = beforeText + newText + afterFullText;

    // Notify parent of change
    if (@file) {
      props.onContentChange(@file.id, @localContent);
    }
  };

  // Helper: Get indentation from a line
  const getLineIndentation = (line: string): string => {
    const match = line.match(/^(\s*)/);
    return match ? match[1] : '';
  };

  // Helper: Calculate word boundaries for navigation
  const findWordBoundary = (line: string, col: number, direction: 'left' | 'right'): number => {
    const isWordChar = (ch: string) => /[a-zA-Z0-9_]/.test(ch);
    
    if (direction === 'left') {
      if (col === 0) return 0;
      let pos = col - 1;
      const startChar = line[pos];
      
      if (startChar && isWordChar(startChar)) {
        // Skip word characters
        while (pos > 0 && isWordChar(line[pos - 1])) {
          pos--;
        }
      } else {
        // Skip non-word characters
        while (pos > 0 && !isWordChar(line[pos - 1]) && line[pos - 1] !== ' ') {
          pos--;
        }
        // Skip spaces
        while (pos > 0 && line[pos - 1] === ' ') {
          pos--;
        }
      }
      return pos;
    } else {
      // direction === 'right'
      if (col >= line.length) return line.length;
      let pos = col;
      const startChar = line[pos];
      
      if (startChar && isWordChar(startChar)) {
        // Skip word characters
        while (pos < line.length && isWordChar(line[pos])) {
          pos++;
        }
      } else {
        // Skip non-word characters
        while (pos < line.length && !isWordChar(line[pos]) && line[pos] !== ' ') {
          pos++;
        }
        // Skip spaces
        while (pos < line.length && line[pos] === ' ') {
          pos++;
        }
      }
      return pos;
    }
  };

  // Helper: Get closing character for auto-pairing
  const getClosingChar = (openChar: string): string | null => {
    const pairs: Record<string, string> = {
      '{': '}',
      '[': ']',
      '(': ')',
      '"': '"',
      "'": "'",
      '`': '`',
    };
    return pairs[openChar] ?? null;
  };

  // Helper: Check if next character matches what we're typing
  const shouldSkipClosing = (line: string, col: number, char: string): boolean => {
    return col < line.length && line[col] === char;
  };

  const onInput = async (text: string, skipAutoPair: boolean = false) => {
    if (!@file || @selections.length === 0) return;
    syncToCurrentFile();

    const currentSel = @selections[0];
    const content =
      @file && @currentFileId === @file.id ? @localContent ?? @file.content : @file?.content ?? '';
    const lines = (content || '').split('\n');
    const currentLine = lines[currentSel.headLine] || '';
    
    const range = {
      startLine: Math.min(currentSel.anchorLine, currentSel.headLine),
      startCol: currentSel.anchorLine === currentSel.headLine
        ? Math.min(currentSel.anchorCol, currentSel.headCol)
        : (currentSel.anchorLine < currentSel.headLine ? currentSel.anchorCol : currentSel.headCol),
      endLine: Math.max(currentSel.anchorLine, currentSel.headLine),
      endCol: currentSel.anchorLine === currentSel.headLine
        ? Math.max(currentSel.anchorCol, currentSel.headCol)
        : (currentSel.anchorLine < currentSel.headLine ? currentSel.headCol : currentSel.anchorCol),
    };

    // Check for auto-pairing closing character skip
    const closingChars = ['}', ']', ')', '"', "'", '`'];
    if (!skipAutoPair && text.length === 1 && closingChars.includes(text)) {
      const shouldBrackets = editorSettings.autoClosingBrackets && ['}', ']', ')'].includes(text);
      const shouldQuotes = editorSettings.autoClosingQuotes && ['"', "'", '`'].includes(text);
      
      if ((shouldBrackets || shouldQuotes) && shouldSkipClosing(currentLine, currentSel.headCol, text)) {
        // Skip over the closing character instead of inserting it
        const newSelection: Selection = {
          anchorLine: currentSel.headLine,
          anchorCol: currentSel.headCol + 1,
          headLine: currentSel.headLine,
          headCol: currentSel.headCol + 1,
        };
        @selections = [newSelection];
        await editorEngine.setSelections(@file.id, [newSelection]);
        return;
      }
    }

    let finalText = text;
    let cursorOffset = text.length; // How far to move cursor after insertion

    // Auto-pair brackets and quotes (only if no selection and single character)
    if (!skipAutoPair && text.length === 1 && currentSel.anchorLine === currentSel.headLine && currentSel.anchorCol === currentSel.headCol) {
      const closingChar = getClosingChar(text);
      if (closingChar) {
        const shouldPair = 
          (editorSettings.autoClosingBrackets && ['{', '[', '('].includes(text)) ||
          (editorSettings.autoClosingQuotes && ['"', "'", '`'].includes(text));
        
        if (shouldPair) {
          finalText = text + closingChar;
          cursorOffset = 1; // Cursor stays between the pair
        }
      }
    }

    // Apply optimistically
    applyLocalEdit(range, finalText);
    @pendingEdits++;

    // Calculate new cursor position after insertion
    const newLines = finalText.split('\n');
    let newLine: number;
    let newCol: number;

    if (newLines.length === 1) {
      newLine = range.startLine;
      newCol = range.startCol + cursorOffset;
    } else {
      newLine = range.startLine + newLines.length - 1;
      newCol = newLines[newLines.length - 1].length;
    }

    const newSelection: Selection = {
      anchorLine: newLine,
      anchorCol: newCol,
      headLine: newLine,
      headCol: newCol,
    };
    @selections = [newSelection];

    // Send to backend (combined edit + selection update in one IPC call)
    try {
      const result = await editorEngine.editBufferWithSelections(
        @file.id,
        { range, newText: finalText },
        [newSelection],
      );
      @serverVersion = result.version;
    } catch (err) {
      console.error('Edit failed:', err);
    } finally {
      @pendingEdits--;
    }

    // Auto-trigger signature help on '(' or ','
    if (text === '(' || text === ',') {
      editorEngine
        .getLspSignatureHelp(@file.id, newLine, newCol)
        .then((help) => {
          if (help && help.signatures.length > 0) {
            @signatureHelp = help;
            @selectedSignatureIndex = help.activeSignature ?? 0;
            @showSignatureHelp = true;
          }
        })
        .catch(() => {});
    }

    // Dismiss signature help on ')'
    if (text === ')') {
      @showSignatureHelp = false;
      @signatureHelp = null;
    }
  };

  const onKeyDown = async (e: KeyboardEvent) => {
    if (!@file || @selections.length === 0) return;
    syncToCurrentFile();

    const currentSel = @selections[0];
    let newSel: Selection | null = null;

    // Get file content to calculate line lengths (match viewport: current file's content)
    const content =
      @file && @currentFileId === @file.id ? @localContent ?? @file.content : @file?.content ?? '';
    const lines = (content || '').split('\n');
    const currentLineLength =
      currentSel.headLine < lines.length ? lines[currentSel.headLine].length : 0;
    const currentLine = lines[currentSel.headLine] || '';

    // Handle Tab
    if (e.key === 'Tab' && !@showCompletion) {
      e.preventDefault();
      const tabString = editorSettings.insertSpaces
        ? ' '.repeat(editorSettings.tabSize)
        : '\t';
      await onInput(tabString, true); // Skip auto-pair for tab
      return;
    }

    // Handle Clipboard Operations
    // Copy (Ctrl+C / Cmd+C)
    if (e.key === 'c' && (e.ctrlKey || e.metaKey) && !e.shiftKey) {
      if (currentSel.anchorLine !== currentSel.headLine || currentSel.anchorCol !== currentSel.headCol) {
        e.preventDefault();
        const startLine = Math.min(currentSel.anchorLine, currentSel.headLine);
        const endLine = Math.max(currentSel.anchorLine, currentSel.headLine);
        const startCol = currentSel.anchorLine === currentSel.headLine
          ? Math.min(currentSel.anchorCol, currentSel.headCol)
          : (currentSel.anchorLine < currentSel.headLine ? currentSel.anchorCol : currentSel.headCol);
        const endCol = currentSel.anchorLine === currentSel.headLine
          ? Math.max(currentSel.anchorCol, currentSel.headCol)
          : (currentSel.anchorLine < currentSel.headLine ? currentSel.headCol : currentSel.anchorCol);
        
        // Extract selected text
        let selectedText = '';
        if (startLine === endLine) {
          selectedText = lines[startLine].substring(startCol, endCol);
        } else {
          selectedText = lines[startLine].substring(startCol) + '\n';
          for (let i = startLine + 1; i < endLine; i++) {
            selectedText += lines[i] + '\n';
          }
          selectedText += lines[endLine].substring(0, endCol);
        }
        
        // Copy to clipboard
        try {
          await navigator.clipboard.writeText(selectedText);
        } catch (err) {
          console.error('Failed to copy to clipboard:', err);
        }
      }
      return;
    }

    // Cut (Ctrl+X / Cmd+X)
    if (e.key === 'x' && (e.ctrlKey || e.metaKey) && !e.shiftKey) {
      if (currentSel.anchorLine !== currentSel.headLine || currentSel.anchorCol !== currentSel.headCol) {
        e.preventDefault();
        const startLine = Math.min(currentSel.anchorLine, currentSel.headLine);
        const endLine = Math.max(currentSel.anchorLine, currentSel.headLine);
        const startCol = currentSel.anchorLine === currentSel.headLine
          ? Math.min(currentSel.anchorCol, currentSel.headCol)
          : (currentSel.anchorLine < currentSel.headLine ? currentSel.anchorCol : currentSel.headCol);
        const endCol = currentSel.anchorLine === currentSel.headLine
          ? Math.max(currentSel.anchorCol, currentSel.headCol)
          : (currentSel.anchorLine < currentSel.headLine ? currentSel.headCol : currentSel.anchorCol);
        
        // Extract selected text
        let selectedText = '';
        if (startLine === endLine) {
          selectedText = lines[startLine].substring(startCol, endCol);
        } else {
          selectedText = lines[startLine].substring(startCol) + '\n';
          for (let i = startLine + 1; i < endLine; i++) {
            selectedText += lines[i] + '\n';
          }
          selectedText += lines[endLine].substring(0, endCol);
        }
        
        // Copy to clipboard and delete selection
        try {
          await navigator.clipboard.writeText(selectedText);
          const range = {
            startLine,
            startCol,
            endLine,
            endCol,
          };
          applyLocalEdit(range, '');
          @pendingEdits++;
          const newSelection: Selection = {
            anchorLine: startLine,
            anchorCol: startCol,
            headLine: startLine,
            headCol: startCol,
          };
          @selections = [newSelection];
          const result = await editorEngine.editBufferWithSelections(
            @file.id,
            { range, newText: '' },
            [newSelection],
          );
          @serverVersion = result.version;
        } catch (err) {
          console.error('Failed to cut to clipboard:', err);
        } finally {
          @pendingEdits--;
        }
      }
      return;
    }

    // Paste (Ctrl+V / Cmd+V)
    if (e.key === 'v' && (e.ctrlKey || e.metaKey) && !e.shiftKey) {
      e.preventDefault();
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          await onInput(text, true); // Skip auto-pair for paste
        }
      } catch (err) {
        console.error('Failed to paste from clipboard:', err);
      }
      return;
    }

    // Handle Word Navigation (Ctrl+Left / Ctrl+Right)
    if (e.key === 'ArrowLeft' && (e.ctrlKey || e.metaKey) && !e.altKey) {
      e.preventDefault();
      const newCol = findWordBoundary(currentLine, currentSel.headCol, 'left');
      newSel = {
        anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine,
        anchorCol: e.shiftKey ? currentSel.anchorCol : newCol,
        headLine: currentSel.headLine,
        headCol: newCol,
      };
    } else if (e.key === 'ArrowRight' && (e.ctrlKey || e.metaKey) && !e.altKey) {
      e.preventDefault();
      const newCol = findWordBoundary(currentLine, currentSel.headCol, 'right');
      newSel = {
        anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine,
        anchorCol: e.shiftKey ? currentSel.anchorCol : newCol,
        headLine: currentSel.headLine,
        headCol: newCol,
      };
    }

    // Handle Line Deletion (Ctrl+Shift+K / Cmd+Shift+K)
    if (e.key === 'k' && (e.ctrlKey || e.metaKey) && e.shiftKey && !@showCompletion) {
      e.preventDefault();
      
      const startLine = Math.min(currentSel.anchorLine, currentSel.headLine);
      const endLine = Math.max(currentSel.anchorLine, currentSel.headLine);
      
      // Delete entire lines (including newline)
      let range;
      if (endLine < lines.length - 1) {
        // Not the last line - delete including newline
        range = {
          startLine,
          startCol: 0,
          endLine: endLine + 1,
          endCol: 0,
        };
      } else if (startLine > 0) {
        // Last line - delete newline from previous line
        range = {
          startLine: startLine - 1,
          startCol: lines[startLine - 1].length,
          endLine,
          endCol: lines[endLine].length,
        };
      } else {
        // Only line in file - just clear it
        range = {
          startLine: 0,
          startCol: 0,
          endLine: 0,
          endCol: lines[0].length,
        };
      }
      
      applyLocalEdit(range, '');
      @pendingEdits++;
      
      const newSelection: Selection = {
        anchorLine: range.startLine,
        anchorCol: range.startCol,
        headLine: range.startLine,
        headCol: range.startCol,
      };
      @selections = [newSelection];
      
      try {
        const result = await editorEngine.editBufferWithSelections(
          @file.id,
          { range, newText: '' },
          [newSelection],
        );
        @serverVersion = result.version;
      } finally {
        @pendingEdits--;
      }
      return;
    }

    // Handle Backspace
    if (e.key === 'Backspace') {
      e.preventDefault();

      // If selection exists, delete selection
      if (
        currentSel.anchorLine !== currentSel.headLine || currentSel.anchorCol !== currentSel.headCol
      ) {
        const range = {
          startLine: Math.min(currentSel.anchorLine, currentSel.headLine),
          startCol: currentSel.anchorLine === currentSel.headLine
            ? Math.min(currentSel.anchorCol, currentSel.headCol)
            : (currentSel.anchorLine < currentSel.headLine
              ? currentSel.anchorCol
              : currentSel.headCol),
          endLine: Math.max(currentSel.anchorLine, currentSel.headLine),
          endCol: currentSel.anchorLine === currentSel.headLine
            ? Math.max(currentSel.anchorCol, currentSel.headCol)
            : (currentSel.anchorLine < currentSel.headLine
              ? currentSel.headCol
              : currentSel.anchorCol),
        };

        applyLocalEdit(range, '');
        @pendingEdits++;

        const newSelection: Selection = {
          anchorLine: range.startLine,
          anchorCol: range.startCol,
          headLine: range.startLine,
          headCol: range.startCol,
        };
        @selections = [newSelection];

        try {
          const result = await editorEngine.editBufferWithSelections(
            @file.id,
            { range, newText: '' },
            [newSelection],
          );
          @serverVersion = result.version;
        } finally {
          @pendingEdits--;
        }
      } else if (currentSel.headCol > 0) {
        // Delete character before cursor
        const range = {
          startLine: currentSel.headLine,
          startCol: currentSel.headCol - 1,
          endLine: currentSel.headLine,
          endCol: currentSel.headCol,
        };

        applyLocalEdit(range, '');
        @pendingEdits++;

        const newSelection: Selection = {
          anchorLine: currentSel.headLine,
          anchorCol: currentSel.headCol - 1,
          headLine: currentSel.headLine,
          headCol: currentSel.headCol - 1,
        };
        @selections = [newSelection];

        try {
          const result = await editorEngine.editBufferWithSelections(
            @file.id,
            { range, newText: '' },
            [newSelection],
          );
          @serverVersion = result.version;
        } finally {
          @pendingEdits--;
        }
      } else if (currentSel.headLine > 0) {
        // Join with previous line
        const prevLineLength = lines[currentSel.headLine - 1].length;
        const range = {
          startLine: currentSel.headLine - 1,
          startCol: prevLineLength,
          endLine: currentSel.headLine,
          endCol: 0,
        };

        applyLocalEdit(range, '');
        @pendingEdits++;

        const newSelection: Selection = {
          anchorLine: currentSel.headLine - 1,
          anchorCol: prevLineLength,
          headLine: currentSel.headLine - 1,
          headCol: prevLineLength,
        };
        @selections = [newSelection];

        try {
          const result = await editorEngine.editBufferWithSelections(
            @file.id,
            { range, newText: '' },
            [newSelection],
          );
          @serverVersion = result.version;
        } finally {
          @pendingEdits--;
        }
      }
      return;
    }

    // Handle Delete
    if (e.key === 'Delete') {
      e.preventDefault();

      // If selection exists, delete selection
      if (
        currentSel.anchorLine !== currentSel.headLine || currentSel.anchorCol !== currentSel.headCol
      ) {
        const range = {
          startLine: Math.min(currentSel.anchorLine, currentSel.headLine),
          startCol: currentSel.anchorLine === currentSel.headLine
            ? Math.min(currentSel.anchorCol, currentSel.headCol)
            : (currentSel.anchorLine < currentSel.headLine
              ? currentSel.anchorCol
              : currentSel.headCol),
          endLine: Math.max(currentSel.anchorLine, currentSel.headLine),
          endCol: currentSel.anchorLine === currentSel.headLine
            ? Math.max(currentSel.anchorCol, currentSel.headCol)
            : (currentSel.anchorLine < currentSel.headLine
              ? currentSel.headCol
              : currentSel.anchorCol),
        };

        applyLocalEdit(range, '');
        @pendingEdits++;

        const newSelection: Selection = {
          anchorLine: range.startLine,
          anchorCol: range.startCol,
          headLine: range.startLine,
          headCol: range.startCol,
        };
        @selections = [newSelection];

        try {
          const result = await editorEngine.editBufferWithSelections(
            @file.id,
            { range, newText: '' },
            [newSelection],
          );
          @serverVersion = result.version;
        } finally {
          @pendingEdits--;
        }
      } else if (currentSel.headCol < currentLineLength) {
        // Delete character after cursor
        const range = {
          startLine: currentSel.headLine,
          startCol: currentSel.headCol,
          endLine: currentSel.headLine,
          endCol: currentSel.headCol + 1,
        };

        applyLocalEdit(range, '');
        @pendingEdits++;

        // Cursor stays in same position
        const newSelection: Selection = {
          anchorLine: currentSel.headLine,
          anchorCol: currentSel.headCol,
          headLine: currentSel.headLine,
          headCol: currentSel.headCol,
        };
        @selections = [newSelection];

        try {
          const result = await editorEngine.editBufferWithSelections(
            @file.id,
            { range, newText: '' },
            [newSelection],
          );
          @serverVersion = result.version;
        } finally {
          @pendingEdits--;
        }
      } else if (currentSel.headLine < lines.length - 1) {
        // Join with next line
        const range = {
          startLine: currentSel.headLine,
          startCol: currentLineLength,
          endLine: currentSel.headLine + 1,
          endCol: 0,
        };

        applyLocalEdit(range, '');
        @pendingEdits++;

        // Cursor stays in same position
        const newSelection: Selection = {
          anchorLine: currentSel.headLine,
          anchorCol: currentSel.headCol,
          headLine: currentSel.headLine,
          headCol: currentSel.headCol,
        };
        @selections = [newSelection];

        try {
          const result = await editorEngine.editBufferWithSelections(
            @file.id,
            { range, newText: '' },
            [newSelection],
          );
          @serverVersion = result.version;
        } finally {
          @pendingEdits--;
        }
      }
      return;
    }

    // Handle Enter
    if (e.key === 'Enter') {
      e.preventDefault();
      
      if (editorSettings.autoIndent) {
        const currentLine = lines[currentSel.headLine] || '';
        const indent = getLineIndentation(currentLine);
        
        // Check if current line ends with opening brace - increase indent
        const trimmed = currentLine.trim();
        const shouldIncreaseIndent = trimmed.endsWith('{') || trimmed.endsWith('[') || trimmed.endsWith('(');
        
        const tabString = editorSettings.insertSpaces
          ? ' '.repeat(editorSettings.tabSize)
          : '\t';
        
        const newLineText = shouldIncreaseIndent ? '\n' + indent + tabString : '\n' + indent;
        await onInput(newLineText, true);
      } else {
        await onInput('\n');
      }
      return;
    }

    // Handle find overlay (Ctrl+F / Cmd+F)
    if (e.key === 'f' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      @showFindOverlay = true;
      return;
    }

    // Completion: when visible, handle navigation and accept
    if (@showCompletion) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        @completionSelectedIndex = Math.min(
          @completionSelectedIndex + 1,
          @completionItems.length - 1,
        );
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        @completionSelectedIndex = Math.max(@completionSelectedIndex - 1, 0);
        return;
      }
      if (e.key === 'Enter' || e.key === 'Tab') {
        e.preventDefault();
        const item = @completionItems[@completionSelectedIndex];
        if (item) {
          const text = item.insertText ?? item.label;
          await onInput(text);
        }
        @showCompletion = false;
        @completionItems = [];
        return;
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        @showCompletion = false;
        @completionItems = [];
        return;
      }
    }

    // Signature help navigation (when not showing completion)
    if (@showSignatureHelp && !@showCompletion) {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        @selectedSignatureIndex = Math.max(0, @selectedSignatureIndex - 1);
        return;
      }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        @selectedSignatureIndex = Math.min(
          (@signatureHelp?.signatures.length ?? 1) - 1,
          @selectedSignatureIndex + 1,
        );
        return;
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        @showSignatureHelp = false;
        @signatureHelp = null;
        return;
      }
    }

    // Trigger signature help (Ctrl+Shift+Space / Cmd+Shift+Space)
    if (e.key === ' ' && (e.ctrlKey || e.metaKey) && e.shiftKey) {
      e.preventDefault();
      editorEngine
        .getLspSignatureHelp(@file.id, currentSel.headLine, currentSel.headCol)
        .then((help) => {
          if (help && help.signatures.length > 0) {
            @signatureHelp = help;
            @selectedSignatureIndex = help.activeSignature ?? 0;
            @showSignatureHelp = true;
          }
        })
        .catch(() => {});
      return;
    }

    // Trigger completion (Ctrl+Space / Cmd+Space without Shift)
    if (e.key === ' ' && (e.ctrlKey || e.metaKey) && !e.shiftKey) {
      e.preventDefault();
      // Dismiss signature help when completion opens
      @showSignatureHelp = false;
      @signatureHelp = null;
      
      editorEngine.getLspCompletion(@file.id, currentSel.headLine, currentSel.headCol).then(
        (items) => {
          if (items && items.length > 0) {
            @completionItems = items;
            @completionSelectedIndex = 0;
            @showCompletion = true;
          }
        },
      ).catch(() => {});
      return;
    }

    // Handle Undo (Ctrl+Z / Cmd+Z)
    if (e.key === 'z' && (e.ctrlKey || e.metaKey) && !e.shiftKey) {
      e.preventDefault();
      try {
        const result = await editorEngine.undo(@file.id);
        if (result.success) {
          @localContent = result.content;
          @serverVersion = result.version;
          @selections = result.selections.selections;
          props.onContentChange(@file.id, result.content);
        }
      } catch (err) {
        console.error('Undo failed:', err);
      }
      return;
    }

    // Handle Redo (Ctrl+Y / Cmd+Shift+Z)
    if (
      (e.key === 'y' && (e.ctrlKey || e.metaKey)) ||
      (e.key === 'z' && (e.ctrlKey || e.metaKey) && e.shiftKey)
    ) {
      e.preventDefault();
      try {
        const result = await editorEngine.redo(@file.id);
        if (result.success) {
          @localContent = result.content;
          @serverVersion = result.version;
          @selections = result.selections.selections;
          props.onContentChange(@file.id, result.content);
        }
      } catch (err) {
        console.error('Redo failed:', err);
      }
      return;
    }

    switch (e.key) {
      case 'ArrowLeft':
        // Skip if Ctrl/Cmd pressed (handled by word navigation above)
        if (e.ctrlKey || e.metaKey) break;
        e.preventDefault();
        if (currentSel.headCol > 0) {
          newSel = {
            anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine,
            anchorCol: e.shiftKey ? currentSel.anchorCol : currentSel.headCol - 1,
            headLine: currentSel.headLine,
            headCol: currentSel.headCol - 1,
          };
        } else if (currentSel.headLine > 0) {
          // Move to end of previous line
          const prevLineLength = lines[currentSel.headLine - 1].length;
          newSel = {
            anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine - 1,
            anchorCol: e.shiftKey ? currentSel.anchorCol : prevLineLength,
            headLine: currentSel.headLine - 1,
            headCol: prevLineLength,
          };
        }
        break;

      case 'ArrowRight':
        // Skip if Ctrl/Cmd pressed (handled by word navigation above)
        if (e.ctrlKey || e.metaKey) break;
        e.preventDefault();
        if (currentSel.headCol < currentLineLength) {
          newSel = {
            anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine,
            anchorCol: e.shiftKey ? currentSel.anchorCol : currentSel.headCol + 1,
            headLine: currentSel.headLine,
            headCol: currentSel.headCol + 1,
          };
        } else if (currentSel.headLine < lines.length - 1) {
          // Move to start of next line
          newSel = {
            anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine + 1,
            anchorCol: e.shiftKey ? currentSel.anchorCol : 0,
            headLine: currentSel.headLine + 1,
            headCol: 0,
          };
        }
        break;

      case 'ArrowUp':
        e.preventDefault();
        if (currentSel.headLine > 0) {
          const targetLineLength = lines[currentSel.headLine - 1].length;
          newSel = {
            anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine - 1,
            anchorCol: e.shiftKey
              ? currentSel.anchorCol
              : Math.min(currentSel.headCol, targetLineLength),
            headLine: currentSel.headLine - 1,
            headCol: Math.min(currentSel.headCol, targetLineLength),
          };
        }
        break;

      case 'ArrowDown':
        e.preventDefault();
        if (currentSel.headLine < lines.length - 1) {
          const targetLineLength = lines[currentSel.headLine + 1].length;
          newSel = {
            anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine + 1,
            anchorCol: e.shiftKey
              ? currentSel.anchorCol
              : Math.min(currentSel.headCol, targetLineLength),
            headLine: currentSel.headLine + 1,
            headCol: Math.min(currentSel.headCol, targetLineLength),
          };
        }
        break;

      case 'Home':
        e.preventDefault();
        newSel = {
          anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine,
          anchorCol: e.shiftKey ? currentSel.anchorCol : 0,
          headLine: currentSel.headLine,
          headCol: 0,
        };
        break;

      case 'End':
        e.preventDefault();
        newSel = {
          anchorLine: e.shiftKey ? currentSel.anchorLine : currentSel.headLine,
          anchorCol: e.shiftKey ? currentSel.anchorCol : currentLineLength,
          headLine: currentSel.headLine,
          headCol: currentLineLength,
        };
        break;
    }

    if (newSel) {
      @selections = [newSel];
      await editorEngine.setSelections(@file.id, [newSel]);
    }
  };

  const handleMouseDown = (line: number, col: number) => {
    @isMouseDown = true;
    const newSelection: Selection = {
      anchorLine: line,
      anchorCol: col,
      headLine: line,
      headCol: col,
    };
    @selections = [newSelection];

    // Focus the hidden textarea so keyboard input is captured
    if (@inputTextarea) {
      @inputTextarea.focus();
    }

    if (@file) {
      editorEngine.setSelections(@file.id, [newSelection]).catch(console.error);
    }
  };

  const handleMouseMove = (line: number, col: number) => {
    if (!@isMouseDown || @selections.length === 0) return;

    const currentSelection = @selections[0];
    const updatedSelection: Selection = {
      anchorLine: currentSelection.anchorLine,
      anchorCol: currentSelection.anchorCol,
      headLine: line,
      headCol: col,
    };
    @selections = [updatedSelection];

    // Throttle IPC calls to every 16ms (one frame)
    if (@file) {
      if (mouseMoveThrottleTimer === null) {
        mouseMoveThrottleTimer = setTimeout(() => {
          if (@file) {
            editorEngine.setSelections(@file.id, @selections).catch(console.error);
          }
          mouseMoveThrottleTimer = null;
        }, 16) as unknown as number;
      }
    }
  };

  const handleMouseUp = () => {
    @isMouseDown = false;
  };

  const containerRef = (el: HTMLDivElement) => {
    @container = el;
    if (el) {
      @containerHeight = el.clientHeight;
    }
  };

  // Keep container height in sync when window/panels resize
  effect(() => {
    const el = @container;
    if (!el) return;

    const observer = new ResizeObserver((entries) => {
      for (const entry of entries) {
        @containerHeight = entry.contentRect.height;
      }
    });
    observer.observe(el);
    return () => {
      observer.disconnect();
    };
  });

  // Add global mouse up listener
  effect(() => {
    const onGlobalMouseUp = () => {
      @isMouseDown = false;
    };
    window.addEventListener('mouseup', onGlobalMouseUp);
    return () => {
      window.removeEventListener('mouseup', onGlobalMouseUp);
    };
  });

  // Clean up mouse move throttle timer on unmount
  effect(() => {
    return () => {
      if (mouseMoveThrottleTimer !== null) {
        clearTimeout(mouseMoveThrottleTimer);
        mouseMoveThrottleTimer = null;
      }
    };
  });

  // Prefer @file (from subscription) over prop - subscription can update before parent re-renders.
  // Since EditorArea recreates RustEditor with a new key when file changes, these values
  // are correctly initialized for each file. We use track() to make them reactive in the template.
  let displayFile = track(@file ?? @fileProp ?? getActiveFile());
  let editorContent = track(
    @displayFile && @currentFileId === @displayFile.id
      ? (@localContent ?? @displayFile.content ?? '')
      : (@displayFile?.content ?? '')
  );

  // Keep editorContent in sync with localContent changes (user typing)
  effect(() => {
    const df = @displayFile;
    if (df && @currentFileId === df.id) {
      rippleSet(editorContent, @localContent ?? df.content ?? '');
    }
  });

  <div class="relative h-full w-full bg-editor-bg text-text-primary" onMouseDown={() => { if (@inputTextarea) @inputTextarea.focus(); }}>
    <div {ref containerRef} class="relative h-full w-full overflow-y-auto" {onScroll}>
      const contentLineCount =
        @editorContent === '' ? 1 : @editorContent.split('\n').length;
      const scrollTotalLines = Math.max(@minimapTotalLines, contentLineCount);
      <div style={{ height: scrollTotalLines * 20 + 'px' }} aria-hidden="true" />
      <div
        class="absolute left-0 top-0 right-0 flex w-full"
        style={{ height: (@containerHeight || 400) + 'px' }}
      >
        const gutterTotalLines = scrollTotalLines;
        <div class="flex-shrink-0">
          <EditorGutter
            totalLines={gutterTotalLines}
            viewportStartLine={Math.floor(@scrollTop / 20)}
            viewportLineCount={@minimapLineCount}
            activeLine={@selections.length > 0 ? @selections[0].headLine : 0}
            {@foldRanges}
            {@foldedStartLines}
            onToggleFold={toggleFoldAtLine}
          />
        </div>
        <div class="flex-1 min-w-0 relative" data-editor-buffer-id={@displayFile?.id ?? ''}>
          for (const fid of [@displayFile?.id ?? '']; key fid) {
            <EditorViewport
              bufferId={@displayFile?.id ?? null}
              content={@editorContent === '' ? null : @editorContent}
              {@scrollTop}
              viewportHeight={@containerHeight || 400}
              lineHeight={20}
              {@selections}
              {@foldRanges}
              {@foldedStartLines}
              {@wordWrap}
              onMouseDown={handleMouseDown}
              onMouseMove={handleMouseMove}
              onMouseUp={handleMouseUp}
            />
          }
          if (@showSignatureHelp && @signatureHelp && @selections.length > 0) {
            const cursorLine = @selections[0].headLine;
            const cursorCol = @selections[0].headCol;
            const activeIndex = @selectedSignatureIndex;
            const sig = @signatureHelp.signatures[activeIndex];
            const activeParam = @signatureHelp.activeParameter;

            <div
              class="absolute max-w-[600px] rounded border border-border-default bg-bg-elevated shadow-lg z-20 px-3 py-2"
              style={{
                top: Math.max(0, (cursorLine - 1) * 20) + 'px',
                left: Math.max(8, cursorCol * 8 + 8) + 'px',
              }}
              data-testid="signature-help"
            >
              <div class="text-[13px] font-mono text-white">
                if (sig.parameters && activeParam !== undefined && sig.parameters[activeParam]) {
                  const param = sig.parameters[activeParam];
                  const paramLabel = param.label;
                  const labelIndex = sig.label.indexOf(paramLabel);
                  
                  if (labelIndex !== -1) {
                    {sig.label.substring(0, labelIndex)}
                    <span class="font-bold text-blue-400">{paramLabel}</span>
                    {sig.label.substring(labelIndex + paramLabel.length)}
                  } else {
                    {sig.label}
                  }
                } else {
                  {sig.label}
                }
              </div>
              if (sig.documentation) {
                <div class="text-[11px] text-white/60 mt-1 max-w-[500px]">
                  {sig.documentation}
                </div>
              }
              if (@signatureHelp.signatures.length > 1) {
                <div class="text-[10px] text-white/40 mt-1">
                  {String(activeIndex + 1)}{" of "}{String(@signatureHelp.signatures.length)}
                </div>
              }
            </div>
          }
          if (@showCompletion && @completionItems.length > 0 && @selections.length > 0) {
            const cursorLine = @selections[0].headLine;
            <div
              class="absolute left-2 right-2 max-h-[200px] overflow-auto rounded border border-border-default bg-bg-elevated shadow-lg z-20 py-1"
              style={{ top: (cursorLine + 1) * 20 + 'px' }}
              data-testid="completion-list"
            >
              for (const entry of @completionItems.map((item, i) => ({ item, i })); key entry.i) {
                const isSelected = entry.i === @completionSelectedIndex;
                <div
                  class={{
                    'px-3 py-1 text-[13px] cursor-pointer': true,
                    'bg-white/15': isSelected,
                    'hover:bg-white/10': !isSelected,
                  }}
                >
                  {entry.item.label}
                  if (entry.item.detail) {
                    <span class="ml-2 text-white/60 text-[11px]">{entry.item.detail}</span>
                  }
                </div>
              }
            </div>
          }
        </div>
      </div>
      <EditorInput {onInput} {onKeyDown} onReady={(el: HTMLTextAreaElement) => { @inputTextarea = el; }} />
    </div>

    <div class="pointer-events-none absolute right-2 top-2 bottom-2 flex flex-col items-end gap-2">
      <div class="pointer-events-auto" data-testid="editor-minimap">
        <EditorMinimap
          totalLines={@minimapTotalLines}
          viewportStartLine={@minimapStartLine}
          viewportLineCount={@minimapLineCount}
          onJumpToLine={jumpToLine}
        />
      </div>
    </div>

    <EditorOverlay
      bufferId={@displayFile?.id ?? null}
      visible={@showFindOverlay}
      onClose={() => {
        @showFindOverlay = false;
      }}
      onGoToMatch={(line: number, col: number) => {
        const newSelection: Selection = {
          anchorLine: line,
          anchorCol: col,
          headLine: line,
          headCol: col,
        };
        @selections = [newSelection];
        if (@file) {
          editorEngine.setSelections(@file.id, [newSelection]).catch(console.error);
        }
      }}
    />
  </div>
}

import type { Selection, HighlightedLine, LspDiagnostic } from '../../lib/editor-engine';

interface TextSegment {
  text: string;
  scope?: string;
}

const CHAR_WIDTH = 7.8;

export component EditorLine(props: {
  lineNum: number;
  lineText: string;
  highlightLine: HighlightedLine | undefined;
  diagnosticsForLine: LspDiagnostic[];
  selections: Selection[];
  wordWrap: boolean;
  onMouseDown: (e: MouseEvent, lineNum: number, lineText: string) => void;
  onMouseMove: (e: MouseEvent, lineNum: number, lineText: string) => void;
  onMouseUp: () => void;
}) {
  // Pre-compute selection state for this line (called once per render)
  const selectionRange = (() => {
    for (const sel of props.selections) {
      const startLine = Math.min(sel.anchorLine, sel.headLine);
      const endLine = Math.max(sel.anchorLine, sel.headLine);
      const startCol = sel.anchorLine <= sel.headLine ? sel.anchorCol : sel.headCol;
      const endCol = sel.anchorLine <= sel.headLine ? sel.headCol : sel.anchorCol;
      
      if (props.lineNum >= startLine && props.lineNum <= endLine) {
        let start = 0;
        let end = props.lineText.length;
        
        if (props.lineNum === startLine) {
          start = startCol;
        }
        if (props.lineNum === endLine) {
          end = endCol;
        }
        
        return { start, end };
      }
    }
    return null;
  })();

  const cursorCol = (() => {
    for (const sel of props.selections) {
      if (sel.anchorLine === sel.headLine && sel.anchorCol === sel.headCol && sel.headLine === props.lineNum) {
        return sel.headCol;
      }
    }
    return null;
  })();

  const textSegments = (() => {
    if (!props.highlightLine || props.highlightLine.spans.length === 0) {
      return [{ text: props.lineText }];
    }

    const result: TextSegment[] = [];
    let lastCol = 0;

    for (const span of props.highlightLine.spans) {
      // Add text before span
      if (span.startCol > lastCol) {
        result.push({ text: props.lineText.substring(lastCol, span.startCol) });
      }
      // Add highlighted span
      result.push({ 
        text: props.lineText.substring(span.startCol, span.endCol), 
        scope: span.scope 
      });
      lastCol = span.endCol;
    }

    // Add remaining text
    if (lastCol < props.lineText.length) {
      result.push({ text: props.lineText.substring(lastCol) });
    }

    return result;
  })();

  <div 
    class="editor-line flex h-[20px] px-2 hover:bg-white/5 relative"
    onMouseDown={(e: MouseEvent) => props.onMouseDown(e, props.lineNum, props.lineText)}
    onMouseMove={(e: MouseEvent) => props.onMouseMove(e, props.lineNum, props.lineText)}
    onMouseUp={props.onMouseUp}
  >
    <div
      class={{
        'editor-line-content relative flex-1': true,
        'whitespace-pre': !props.wordWrap,
        'whitespace-pre-wrap break-words': props.wordWrap,
      }}
    >
      if (selectionRange !== null && selectionRange.start < selectionRange.end) {
        <div 
          class="absolute top-0 h-full bg-bg-selected pointer-events-none"
          style={{ 
            left: (selectionRange.start * CHAR_WIDTH) + 'px', 
            width: ((selectionRange.end - selectionRange.start) * CHAR_WIDTH) + 'px' 
          }}
        />
      }

      for (const diag of props.diagnosticsForLine; key `${props.lineNum}-${diag.message}-${diag.range.startCharacter}-${diag.range.endCharacter}`) {
        const startLine = diag.range.startLine;
        const endLine = diag.range.endLine;
        const lineLen = props.lineText.length;
        const startCol = startLine === props.lineNum ? diag.range.startCharacter : 0;
        const endCol = endLine === props.lineNum ? diag.range.endCharacter : lineLen;
        if (endCol > startCol) {
          const severityClass = diag.severity === 1 ? 'diagnostic-error' : diag.severity === 2 ? 'diagnostic-warning' : 'diagnostic-info';
          <div 
            class={`absolute top-[18px] left-0 h-[2px] pointer-events-none ${severityClass}`}
            style={{ 
              left: (startCol * CHAR_WIDTH) + 'px', 
              width: ((endCol - startCol) * CHAR_WIDTH) + 'px' 
            }}
            title={diag.message}
          />
        }
      }
      
      if (cursorCol !== null) {
        <div 
          class="absolute top-0 h-full w-[2px] bg-white animate-pulse pointer-events-none"
          style={{ left: (cursorCol * CHAR_WIDTH) + 'px' }}
        />
      }
      
      <div class="relative z-10">
        for (const segment of textSegments; key `${props.lineNum}-${textSegments.indexOf(segment)}`) {
          if (segment.scope) {
            <span class={`token-${segment.scope}`}>{segment.text}</span>
          } else {
            {segment.text}
          }
        }
      </div>
    </div>
  </div>
}

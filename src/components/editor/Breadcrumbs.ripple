import { track, effect } from 'ripple';
import {
  subscribeToActiveFile,
  getActiveFile,
  workspacePath,
  isSpecialTab,
} from '../../lib/workspace';
import type { OpenFile } from '../../lib/workspace';

export component Breadcrumbs() {
  let segments = track<string[]>([]);
  let isVisible = track(false);

  effect(() => {
    const unsubscribe = subscribeToActiveFile(() => {
      const file = getActiveFile();
      if (!file || isSpecialTab(file) || !file.path) {
        @isVisible = false;
        @segments = [];
        return;
      }

      @isVisible = true;
      const wsPath = workspacePath;
      let relativePath = file.path;
      if (wsPath && file.path.startsWith(wsPath + '/')) {
        relativePath = file.path.slice(wsPath.length + 1);
      } else if (wsPath && file.path.startsWith(wsPath + '\\')) {
        relativePath = file.path.slice(wsPath.length + 1);
      }

      // Split into path segments
      const parts = relativePath.split(/[/\\]/);
      @segments = parts;
    });

    return unsubscribe;
  });

  <div
    class={{
      'flex items-center h-[22px] px-3 bg-editor-bg border-b border-border-default text-[12px] text-text-muted overflow-x-auto scrollbar-none': true,
      hidden: !@isVisible,
    }}
  >
    for (const segment of @segments; index i) {
      if (i > 0) {
        <svg class="w-3 h-3 mx-0.5 shrink-0 opacity-50" viewBox="0 0 16 16" fill="currentColor">
          <path
            d="M6 12l4-4-4-4"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      }
      <span
        class={{
          'shrink-0 hover:text-text-primary cursor-default transition-colors whitespace-nowrap': true,
          'text-text-primary': i === @segments.length - 1,
        }}
      >
        {segment}
      </span>
    }
  </div>
}

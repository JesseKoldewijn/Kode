import { track, effect, trackSplit } from 'ripple';
import { editorEngine, type ViewportHighlights, type Selection, type HighlightedLine, type FoldRange, type LspDiagnostic } from '../../lib/editor-engine';
import { EditorLine } from './EditorLine.ripple';
import { listen, type UnlistenFn } from '@tauri-apps/api/event';

export component EditorViewport(props: {
  bufferId: string | null;
  content: string | null;
  scrollTop: number;
  viewportHeight: number;
  lineHeight: number;
  selections: Selection[];
  foldRanges: FoldRange[] | null;
  foldedStartLines: number[];
  wordWrap: boolean;
  onMouseDown: (line: number, col: number) => void;
  onMouseMove: (line: number, col: number) => void;
  onMouseUp: () => void;
}) {
  const [content, bufferIdProp, scrollTopProp, viewportHeightProp, lineHeightProp, foldRangesProp, foldedStartLinesProp, rest] = trackSplit(props, [
    'content',
    'bufferId',
    'scrollTop',
    'viewportHeight',
    'lineHeight',
    'foldRanges',
    'foldedStartLines',
  ]);
  let highlights = track<ViewportHighlights | null>(null);
  let highlightMap = track<Map<number, HighlightedLine>>(new Map());
  let diagnostics = track<LspDiagnostic[]>([]);
  let diagnosticsByLine = track<Map<number, LspDiagnostic[]>>(new Map());
  let cachedLines = track<string[]>([]);
  let lastBufferId = track<string | null>(null);
  let highlightFetchTimer: number | null = null; // NOT tracked - just a regular variable
  let hoverContent = track<string | null>(null);
  let hoverTimer: number | null = null;
  let lastHoverLine = 0;
  let lastHoverCol = 0;

  // Cache split lines from reactive content so viewport updates when file switches
  effect(() => {
    const c = @content;
    if (c) {
      @cachedLines = c.split('\n');
    } else {
      @cachedLines = [];
    }
  });

  // Build highlight map for O(1) lookups
  effect(() => {
    const map = new Map<number, HighlightedLine>();
    if (@highlights?.lines) {
      for (const line of @highlights.lines) {
        map.set(line.lineNumber, line);
      }
    }
    @highlightMap = map;
  });

  // Reset highlights when buffer changes
  effect(() => {
    const bid = @bufferIdProp;
    if (bid !== @lastBufferId) {
      @highlights = null;
      @diagnostics = [];
      @diagnosticsByLine = new Map();
      @hoverContent = null;
      @lastBufferId = bid;
    }
  });

  // Listen for LSP diagnostic events from backend
  effect(() => {
    const bid = @bufferIdProp;
    if (!bid) return () => {};

    let unlisten: UnlistenFn | null = null;

    // Set up event listener
    listen<{ path: string; diagnostics: LspDiagnostic[] }>('lsp-diagnostics', (event) => {
      // Only update if this event is for the current buffer
      if (event.payload.path === bid) {
        const list = event.payload.diagnostics;
        @diagnostics = list;
        const byLine = new Map<number, LspDiagnostic[]>();
        for (const d of list) {
          const start = d.range.startLine;
          const end = d.range.endLine;
          for (let line = start; line <= end; line++) {
            const arr = byLine.get(line) ?? [];
            arr.push(d);
            byLine.set(line, arr);
          }
        }
        @diagnosticsByLine = byLine;
      }
    }).then((fn) => {
      unlisten = fn;
    }).catch((err) => {
      console.error('[EditorViewport] Failed to set up diagnostic listener:', err);
    });

    // Also fetch initial diagnostics (in case LSP already has them)
    editorEngine.getLspDiagnostics(bid).then((list) => {
      @diagnostics = list;
      const byLine = new Map<number, LspDiagnostic[]>();
      for (const d of list) {
        const start = d.range.startLine;
        const end = d.range.endLine;
        for (let line = start; line <= end; line++) {
          const arr = byLine.get(line) ?? [];
          arr.push(d);
          byLine.set(line, arr);
        }
      }
      @diagnosticsByLine = byLine;
    }).catch(() => {});

    return () => {
      if (unlisten) unlisten();
    };
  });

  // Debounced highlight fetching
  effect(() => {
    const bid = @bufferIdProp;
    if (!bid) {
      @highlights = null;
      return () => {};
    }

    // Clear existing timer
    if (highlightFetchTimer !== null) {
      clearTimeout(highlightFetchTimer);
    }

    const startLine = Math.floor(@scrollTopProp / @lineHeightProp);
    const endLine = startLine + Math.ceil(@viewportHeightProp / @lineHeightProp) + 1;

    // Debounce by 50ms to reduce highlight fetches during rapid changes
    highlightFetchTimer = setTimeout(() => {
      editorEngine.getHighlights(bid, startLine, endLine).then((data) => {
        @highlights = data;
      }).catch((err) => {
        console.error('[EditorViewport] Failed to fetch highlights:', err);
      });
    }, 50) as unknown as number;

    return () => {
      if (highlightFetchTimer !== null) {
        clearTimeout(highlightFetchTimer);
        highlightFetchTimer = null;
      }
    };
  });

  // Clean up hover timer on unmount
  effect(() => {
    return () => {
      if (hoverTimer !== null) {
        clearTimeout(hoverTimer);
        hoverTimer = null;
      }
    };
  });

  let contentLines = track(() => {
    const c = @content;
    return c ? c.split('\n') : [];
  });

  let logicalTotalLines = track(() => {
    const lines = @contentLines;
    return lines.length > 0
      ? lines.length
      : (@cachedLines.length > 0 ? @cachedLines.length : (@highlights?.totalLines || 0));
  });

  let foldedSet = track(() => new Set<number>(@foldedStartLinesProp));
  let activeFoldedRanges = track(() =>
    (@foldRangesProp || []).filter((range) => @foldedSet.has(range.startLine))
  );

  let visibleLineNumbers = track(() => {
    const result: number[] = [];
    const total = @logicalTotalLines;
    const ranges = @activeFoldedRanges;
    let i = 0;

    while (i < total) {
      const range = ranges.find((r) => r.startLine === i);
      if (range) {
        result.push(i);
        i = range.endLine + 1;
      } else {
        const covered = ranges.some((r) => i > r.startLine && i <= r.endLine);
        if (!covered) {
          result.push(i);
        }
        i++;
      }
    }
    return result;
  });

  let totalHeight = track(() => @visibleLineNumbers.length * @lineHeightProp);
  let startIndex = track(() => Math.floor(@scrollTopProp / @lineHeightProp));

  const getLineText = (lineNum: number, lines: string[]): string => {
    if (lines.length > 0) {
      return lines[lineNum] ?? '';
    }
    if (@cachedLines.length > 0) {
      return @cachedLines[lineNum] || '';
    }
    if (@highlightMap.has(lineNum)) {
      return @highlightMap.get(lineNum)!.text;
    }
    return '';
  };

  const getVisibleLineNumbers = (visible: number[], start: number, vh: number, lh: number): number[] => {
    const endIndex = start + Math.ceil(vh / lh) + 1;
    const result: number[] = [];
    for (let i = start; i < Math.min(endIndex, visible.length); i++) {
      result.push(visible[i]);
    }
    return result;
  };

  const handleLineMouseDown = (e: MouseEvent, lineNum: number, lineText: string) => {
    const target = e.target as HTMLElement;
    const lineElement = target.closest('.editor-line') as HTMLElement;
    if (!lineElement) return;
    
    const codeContent = lineElement.querySelector('.editor-line-content') as HTMLElement;
    if (!codeContent) return;
    
    const rect = codeContent.getBoundingClientRect();
    const x = e.clientX - rect.left;
    
    // Approximate column based on character width (monospace assumption)
    const charWidth = 7.8; // Approximate width for 13px monospace font
    const col = Math.max(0, Math.min(Math.floor(x / charWidth), lineText.length));
    
    @rest.onMouseDown(lineNum, col);
  };

  const handleLineMouseMove = (e: MouseEvent, lineNum: number, lineText: string) => {
    const target = e.target as HTMLElement;
    const lineElement = target.closest('.editor-line') as HTMLElement;
    if (!lineElement) return;

    const codeContent = lineElement.querySelector('.editor-line-content') as HTMLElement;
    if (!codeContent) return;

    const rect = codeContent.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const charWidth = 7.8;
    const col = Math.max(0, Math.min(Math.floor(x / charWidth), lineText.length));

    @rest.onMouseMove(lineNum, col);

    const bid = @bufferIdProp;
    if (bid) {
      if (hoverTimer !== null) clearTimeout(hoverTimer);
      lastHoverLine = lineNum;
      lastHoverCol = col;
      hoverTimer = window.setTimeout(() => {
        hoverTimer = null;
        editorEngine.getLspHover(bid, lastHoverLine, lastHoverCol).then((result) => {
          @hoverContent = result?.contents ?? null;
        }).catch(() => {});
      }, 400);
    }
  };

  <div class="relative w-full overflow-hidden font-mono text-[13px]" style={{ height: @viewportHeightProp + 'px' }}>
    if (@hoverContent) {
      <div
        class="absolute top-1 right-2 max-w-[320px] max-h-[200px] overflow-auto rounded border border-border-default bg-bg-elevated shadow-lg z-30 px-3 py-2 text-[12px] text-text-primary whitespace-pre-wrap"
        data-testid="hover-tooltip"
      >
        {@hoverContent}
      </div>
    }
    <div class="absolute w-full" style={{ height: @totalHeight + 'px' }}>
      <div class="absolute w-full" style={{ transform: `translateY(${@startIndex * @lineHeightProp}px)` }}>
        for (const lineNum of getVisibleLineNumbers(@visibleLineNumbers, @startIndex, @viewportHeightProp, @lineHeightProp); key `${@bufferIdProp}-${lineNum}`) {
          <EditorLine 
            lineNum={lineNum}
            lineText={getLineText(lineNum, @contentLines)}
            highlightLine={@highlightMap.get(lineNum) || null}
            diagnosticsForLine={@diagnosticsByLine.get(lineNum) ?? []}
            selections={@rest.selections}
            wordWrap={@rest.wordWrap}
            onMouseDown={handleLineMouseDown}
            onMouseMove={handleLineMouseMove}
            onMouseUp={@rest.onMouseUp}
          />
        }
      </div>
    </div>
  </div>
}

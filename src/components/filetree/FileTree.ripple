import { track, effect } from 'ripple';
import { FileNodeRow } from './FileNodeRow.ripple';
import { ContextMenu, type ContextMenuAction, type ContextMenuState } from './ContextMenu.ripple';
import { ConfirmDialog, type ConfirmDialogResult } from '../common/ConfirmDialog.ripple';
import {
  fileTree,
  workspacePath,
  setWorkspacePath,
  loadWorkspace,
  toggleDirectory,
  refreshWorkspace,
  openFile,
  createNewFile,
  createNewDirectory,
  deletePath,
  renamePath,
  subscribeToWorkspacePath,
  subscribeToFileTreeChanges,
  flattenVisibleNodes,
} from '../../lib/workspace';
import type { FileTreeNode } from '../../lib/workspace';
import { shell, dialog } from '../../lib/tauri';

export component FileTree() {
  let selectedId = track<string | null>(null);
  let isCreatingFile = track(false);
  let isCreatingFolder = track(false);
  let newItemName = track('');
  let newItemParent = track<string | null>(null);
  let currentWorkspacePath = track<string | null>(workspacePath);
  let nodes = track<FileTreeNode[]>([]);
  const visibleNodes = track(() => flattenVisibleNodes(@nodes));

  // Context menu state
  let contextMenu = track<ContextMenuState>({ isOpen: false, x: 0, y: 0, node: null });

  // Rename state
  let isRenaming = track(false);
  let renameNodePath = track<string | null>(null);
  let renameValue = track('');

  // Delete confirmation state
  let deleteConfirmOpen = track(false);
  let deleteTargetNode = track<FileTreeNode | null>(null);

  // Subscribe to workspace path changes
  effect(() => {
    const unsubscribe = subscribeToWorkspacePath((path) => {
      @currentWorkspacePath = path;
      if (path) {
        loadWorkspace(path).then(() => {
          @nodes = [...fileTree];
        });
      } else {
        @nodes = [];
      }
    });
    return unsubscribe;
  });

  // Subscribe to external file tree changes (from file watcher)
  effect(() => {
    const unsubscribe = subscribeToFileTreeChanges(() => {
      @nodes = [...fileTree];
    });
    return unsubscribe;
  });

  // Initialize workspace on mount if path is set
  // OR auto-load demo workspace in mock mode
  effect(() => {
    const path = workspacePath;
    if (path) {
      if (fileTree.length === 0) {
        loadWorkspace(path).then(() => {
          @nodes = [...fileTree];
        });
      } else {
        @nodes = [...fileTree];
      }
    } else {
      // Auto-load demo workspace if in mock mode
      if (typeof __ENABLE_MOCKS__ !== 'undefined' && __ENABLE_MOCKS__) {
        console.log('[FileTree] Auto-loading demo workspace in mock mode');
        import('../../lib/mocks').then(({ getDemoWorkspacePath }) => {
          const demoPath = getDemoWorkspacePath();
          setWorkspacePath(demoPath);
        });
      } else {
        @nodes = [];
      }
    }
  });

  const handleToggle = async (node: FileTreeNode) => {
    await toggleDirectory(node);
    // Create new array reference to trigger Ripple reactivity
    @nodes = [...fileTree];
  };

  const handleSelect = (node: FileTreeNode) => {
    @selectedId = node.id;
    if (!node.isDirectory) {
      openFile(node.path, node.name);
    }
  };

  const handleNodeClick = (e: MouseEvent, node: FileTreeNode) => {
    e.stopPropagation();
    handleSelect(node);
    if (node.isDirectory) {
      handleToggle(node);
    }
  };

  const handleRefresh = async () => {
    await refreshWorkspace();
    // Refresh is already handled by subscribeToFileTreeChanges
  };

  const startCreateFile = () => {
    @isCreatingFile = true;
    @isCreatingFolder = false;
    @newItemName = '';
    @newItemParent = workspacePath;
  };

  const startCreateFolder = () => {
    @isCreatingFolder = true;
    @isCreatingFile = false;
    @newItemName = '';
    @newItemParent = workspacePath;
  };

  const handleCreateSubmit = async () => {
    const name = @newItemName.trim();
    const parent = @newItemParent || workspacePath;

    if (!name || !parent) {
      cancelCreate();
      return;
    }

    if (@isCreatingFile) {
      await createNewFile(parent, name);
    } else if (@isCreatingFolder) {
      await createNewDirectory(parent, name);
    }

    // Refresh to show new item
    await handleRefresh();
    cancelCreate();
  };

  const cancelCreate = () => {
    @isCreatingFile = false;
    @isCreatingFolder = false;
    @newItemName = '';
    @newItemParent = null;
  };

  const handleKeyDown = (e: KeyboardEvent) => {
    if (e.key === 'Enter') {
      if (@isRenaming) {
        handleRenameSubmit();
      } else {
        handleCreateSubmit();
      }
    } else if (e.key === 'Escape') {
      if (@isRenaming) {
        cancelRename();
      } else {
        cancelCreate();
      }
    }
  };

  const handleNodeContextMenu = (e: MouseEvent, node: FileTreeNode) => {
    @contextMenu = { isOpen: true, x: e.clientX, y: e.clientY, node };
  };

  const closeContextMenu = () => {
    @contextMenu = { isOpen: false, x: 0, y: 0, node: null };
  };

  const handleContextMenuAction = async (action: ContextMenuAction, node: FileTreeNode) => {
    switch (action) {
      case 'newFile': {
        const parent =
          node.isDirectory ? node.path : node.path.substring(0, node.path.lastIndexOf('/'));
        @newItemParent = parent;
        @isCreatingFile = true;
        @isCreatingFolder = false;
        @newItemName = '';
        break;
      }
      case 'newFolder': {
        const parent =
          node.isDirectory ? node.path : node.path.substring(0, node.path.lastIndexOf('/'));
        @newItemParent = parent;
        @isCreatingFolder = true;
        @isCreatingFile = false;
        @newItemName = '';
        break;
      }
      case 'rename':
        @isRenaming = true;
        @renameNodePath = node.path;
        @renameValue = node.name;
        break;
      case 'delete':
        @deleteTargetNode = node;
        @deleteConfirmOpen = true;
        break;
      case 'copyPath':
        try {
          await navigator.clipboard.writeText(node.path);
        } catch (err) {
          console.error('Failed to copy path:', err);
        }
        break;
      case 'copyRelativePath': {
        const wsPath = workspacePath;
        let relativePath = node.path;
        if (wsPath && node.path.startsWith(wsPath + '/')) {
          relativePath = node.path.slice(wsPath.length + 1);
        } else if (wsPath && node.path.startsWith(wsPath + '\\')) {
          relativePath = node.path.slice(wsPath.length + 1);
        }
        try {
          await navigator.clipboard.writeText(relativePath);
        } catch (err) {
          console.error('Failed to copy relative path:', err);
        }
        break;
      }
      case 'revealInFileManager':
        // Open the parent directory for files, or the directory itself
        const dirPath =
          node.isDirectory ? node.path : node.path.substring(0, node.path.lastIndexOf('/'));
        await shell.openUrl(dirPath);
        break;
    }
  };

  const handleRenameSubmit = async () => {
    const name = @renameValue.trim();
    const oldPath = @renameNodePath;
    if (!name || !oldPath) {
      cancelRename();
      return;
    }
    const parentDir = oldPath.substring(0, oldPath.lastIndexOf('/'));
    const newPath = `${parentDir}/${name}`;
    if (newPath !== oldPath) {
      await renamePath(oldPath, newPath);
      await handleRefresh();
    }
    cancelRename();
  };

  const cancelRename = () => {
    @isRenaming = false;
    @renameNodePath = null;
    @renameValue = '';
  };

  const handleDeleteConfirm = async (result: ConfirmDialogResult) => {
    if (result === 'dont-save' && @deleteTargetNode) {
      await deletePath(@deleteTargetNode.path);
      await handleRefresh();
    }
    @deleteConfirmOpen = false;
    @deleteTargetNode = null;
  };

  const handleOpenFolder = async () => {
    const selected = await dialog.openDialog(
      {
        directory: true,
        multiple: false,
        title: 'Open Folder',
      },
    );
    if (selected && typeof selected === 'string') {
      setWorkspacePath(selected);
    }
  };

  <div class="py-1 h-full overflow-y-auto" data-testid="filetree">
    <div
      class="flex items-center justify-between px-4 py-1.5 text-[11px] font-semibold text-text-secondary hover:text-text-primary cursor-pointer"
    >
      <span class="uppercase tracking-wider">{'EXPLORER'}</span>
      <div class="flex items-center gap-0.5">
        <button
          class={{
            'p-0.5 bg-transparent border-none rounded text-text-secondary hover:bg-bg-hover hover:text-text-primary cursor-pointer transition-all duration-150': true,
            'opacity-50 cursor-not-allowed': !@currentWorkspacePath,
          }}
          title="New File"
          onClick={startCreateFile}
          disabled={!@currentWorkspacePath}
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 14h-3v3h-2v-3H8v-2h3v-3h2v3h3v2zm-3-7V3.5L18.5 9H13z"
            />
          </svg>
        </button>
        <button
          class={{
            'p-0.5 bg-transparent border-none rounded text-text-secondary hover:bg-bg-hover hover:text-text-primary cursor-pointer transition-all duration-150': true,
            'opacity-50 cursor-not-allowed': !@currentWorkspacePath,
          }}
          title="New Folder"
          onClick={startCreateFolder}
          disabled={!@currentWorkspacePath}
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z"
            />
          </svg>
        </button>
        <button
          class={{
            'p-0.5 bg-transparent border-none rounded text-text-secondary hover:bg-bg-hover hover:text-text-primary cursor-pointer transition-all duration-150': true,
            'opacity-50 cursor-not-allowed': !@currentWorkspacePath,
          }}
          title="Refresh"
          onClick={handleRefresh}
          disabled={!@currentWorkspacePath}
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
            />
          </svg>
        </button>
      </div>
    </div>

    <div
      class={{ 'px-4 py-1': true, hidden: !@isCreatingFile && !@isCreatingFolder && !@isRenaming }}
    >
      <input
        type="text"
        placeholder={@isRenaming
          ? 'New name...'
          : @isCreatingFile
            ? 'File name...'
            : 'Folder name...'}
        class="w-full px-2 py-1 text-sm bg-bg-elevated border border-accent rounded-[3px] text-text-primary focus:outline-none"
        value={@isRenaming ? @renameValue : @newItemName}
        onInput={(e: InputEvent) => {
          const val = (e.target as HTMLInputElement).value;
          if (@isRenaming) {
            @renameValue = val;
          } else {
            @newItemName = val;
          }
        }}
        onKeyDown={handleKeyDown}
        onBlur={() => {
          if (@isRenaming) {
            cancelRename();
          } else {
            cancelCreate();
          }
        }}
        autofocus
      />
    </div>

    <div class="px-1">
      <div class={{ hidden: @currentWorkspacePath }}>
        <div class="px-4 py-8 text-center">
          <p class="text-sm text-text-muted mb-4">{'No folder opened'}</p>
          <button
            class="px-4 py-2 bg-accent text-white rounded-md text-sm font-medium hover:bg-accent/90 transition-colors"
            onClick={handleOpenFolder}
          >
            {'Open Folder'}
          </button>
        </div>
      </div>

      <div class={{ hidden: !@currentWorkspacePath }}>
        <div
          class={{
            'px-4 py-4 text-sm text-text-muted text-center': true,
            hidden: @nodes.length > 0,
          }}
        >
          {'Loading...'}
        </div>
        <div class={{ hidden: @nodes.length === 0 }}>
          for (const { node, depth } of @visibleNodes) {
            <FileNodeRow
              {node}
              {depth}
              isSelected={@selectedId === node.id}
              onClick={handleNodeClick}
              onContextMenu={handleNodeContextMenu}
              key={node.id}
            />
          }
        </div>
      </div>
    </div>

    <ContextMenu
      state={@contextMenu}
      workspacePath={@currentWorkspacePath}
      onAction={handleContextMenuAction}
      onClose={closeContextMenu}
    />

    <ConfirmDialog
      isOpen={@deleteConfirmOpen}
      title="Delete"
      message="Are you sure you want to delete this item? This action cannot be undone."
      fileName={@deleteTargetNode ? @deleteTargetNode.name : ''}
      showSaveButton={false}
      onResult={handleDeleteConfirm}
    />
  </div>
}
